# AgroVoz — Variables de entorno PRODUCCIÓN
# ==========================================
# Copiar a .env.production en el VPS y completar con valores reales.
# NUNCA commitees .env.production al repo.
#
# En Dokploy: configurar estas variables en la sección Environment
# de la app agrovoz-backend (Dokploy inyecta el archivo automáticamente).

# ── Entorno ───────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# ── Base de datos ─────────────────────────────────────────────
# SQLite: ruta dentro del contenedor. El volumen backend_data
# se monta en /app/data, así que el path estándar funciona.
DATABASE_URL=sqlite:////app/data/agrovoz.db

# ── Servidor ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Open-WA (gateway WhatsApp self-hosted) ────────────────────
# API_KEY: contraseña para proteger la API de Open-WA.
#   Generar con: openssl rand -hex 32
OPENWA_API_KEY=

# WEBHOOK_SECRET: secreto compartido para validar HMAC de webhooks.
#   Generar con: openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=

# URL interna de Open-WA (servicio en mismo docker-compose)
OPENWA_API_URL=http://openwa:8000

# ── OpenWeatherMap (DEPRECATED) ───────────────────────────────
# Migrado a OpenMeteo (issue #51). Sin API key.
# Se mantiene por compatibilidad, no afecta el funcionamiento.
OPENWEATHERMAP_API_KEY=

# ── ODEPA ─────────────────────────────────────────────────────
# Hora de sincronización diaria de precios (formato 24h, hora chilena)
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ────────────────────────────────────────────────
# Whisper: small (recomendado para MVP, balance precisión/velocidad)
WHISPER_MODEL=small

# LLM: ruta al modelo cuantizado .gguf dentro del contenedor
# El volumen backend_models se monta en /app/models
LLM_MODEL_PATH=/app/models/qwen2.5-3b-q4_k_m.gguf

# Piper TTS: voz en español (calidad high)
PIPER_VOICE=es_MX-claude-high

# ── Admin Dashboard ───────────────────────────────────────────
# API key para acceder al dashboard (header X-Admin-Key)
# Generar con: openssl rand -hex 32
ADMIN_API_KEY=

# ── Seguridad ─────────────────────────────────────────────────
# Rate limiting: requests por minuto por IP
RATE_LIMIT_PER_MINUTE=60

# Retención de audio: horas antes de borrado automático
AUDIO_RETENTION_HOURS=24

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Piper TTS ─────────────────────────────────────────────────
# Ruta al archivo .onnx del modelo Piper dentro del contenedor
PIPER_MODEL_PATH=/app/models/es_MX-claude-high.onnx
