# AgroVoz — Variables de entorno PRODUCCIÓN
# ==========================================
# Copiar a .env.production en el VPS y completar con valores reales.
# NUNCA commitees .env.production al repo.
#
# En Dokploy: configurar estas variables en la sección Environment
# de la app agrovoz-backend (Dokploy inyecta el archivo automáticamente).

# ── Entorno ───────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# ── Base de datos ─────────────────────────────────────────────
# SQLite: ruta dentro del contenedor. El volumen backend_data
# se monta en /app/data, así que el path estándar funciona.
DATABASE_URL=sqlite:////app/data/agrovoz.db

# ── Servidor ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Open-WA (gateway WhatsApp self-hosted) ────────────────────
# API_KEY: contraseña para proteger la API de Open-WA.
#   Generar con: openssl rand -hex 32
OPENWA_API_KEY=

# WEBHOOK_SECRET: secreto compartido para validar HMAC de webhooks.
#   Generar con: openssl rand -hex 32
OPENWA_WEBHOOK_SECRET=

# URL interna de Open-WA (servicio en mismo docker-compose).
# Puerto 2785 = API REST interna de Open-WA (v0.4.0+).
# Debe coincidir con el puerto `expose` del servicio openwa en docker-compose.prod.yml.
OPENWA_API_URL=http://openwa:2785

# ── OpenWeatherMap (DEPRECATED) ───────────────────────────────
# Migrado a OpenMeteo (issue #51). Sin API key.
# Se mantiene por compatibilidad, no afecta el funcionamiento.
OPENWEATHERMAP_API_KEY=

# ── ODEPA ─────────────────────────────────────────────────────
# Hora de sincronización diaria de precios (formato 24h, hora chilena)
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ────────────────────────────────────────────────
# Whisper: small (recomendado para MVP, balance precisión/velocidad)
WHISPER_MODEL=small

# LLM: ruta al modelo cuantizado .gguf dentro del contenedor
# El volumen backend_models se monta en /app/models
LLM_MODEL_PATH=/app/models/qwen2.5-3b-q4_k_m.gguf

# Piper TTS: voz en español (calidad high)
PIPER_VOICE=es_MX-claude-high

# ── Proveedor LLM global (OpenRouter primero, Qwen después) ─────────
# El fast-path determinístico corre antes de ambos. Las operaciones con
# escritura van al Qwen local para evitar duplicados tras un timeout remoto.
LLM_PRIMARY_PROVIDER=openrouter
OPENROUTER_PRIMARY_TIMEOUT_SECONDS=2.0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=8.0
OPENROUTER_MAX_OUTPUT_TOKENS=120

# ── Admin Dashboard ───────────────────────────────────────────
# API key para endpoints JSON del dashboard (header X-Admin-Key).
# Secret para firmar la cookie de sesión del login HTML (dashboard SSR).
# La app bloquea el arranque si se dejan los defaults de desarrollo.
# Generar con: openssl rand -hex 32
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=

# ── RPC administrativa interna tipo MCP (post-MVP, issue #200) ─
# APAGADA por defecto. Es una interfaz administrativa interna; no se debe
# montar ni publicar su router mientras este gate permanezca desactivado.
# Si se habilita, generar dos claves distintas con: openssl rand -hex 32
MCP_ENABLED=false
MCP_API_KEY=
MCP_ADMIN_KEY=

# ── Estado conversacional (post-MVP, issue #192) ─────────────
# APAGADO hasta validar concurrencia y timeout en el hardware piso.
USE_CONVERSATION_STATE=false
CONVERSATION_TIMEOUT_MINUTES=30

# ── Seguridad ─────────────────────────────────────────────────
# Pepper key para anonimizar números de teléfono (HMAC-SHA256).
# OBLIGATORIO en producción: la app bloquea el arranque si queda el default.
# Generar con: openssl rand -hex 32
PHONE_HASH_PEPPER=

# Rate limiting: requests por minuto por IP
RATE_LIMIT_PER_MINUTE=60
# Cuota global de alertas proactivas enviadas a Open-WA por minuto.
ALERT_RATE_LIMIT_PER_MINUTE=30

# Retención de audio: horas antes de borrado automático
AUDIO_RETENTION_HOURS=24

# ── Historial de consultas (post-MVP, issue #201) ─────────────
# APAGADO hasta implementar purga TTL, auditoría append-only de borrados y
# completar la revisión legal formal previa a producción.
CONSULTATION_HISTORY_ENABLED=false
# Retención del historial consentido. Debe ser al menos 1 día.
CONSULTATION_HISTORY_TTL_DAYS=28
# Obligatoria al activar el historial; mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
CONSULTATION_HISTORY_AUDIT_KEY=

# ── Registro de gastos por voz (#170, incompleto) ─────────────
# APAGADO hasta implementar tabla, retención/borrado, consentimiento aprobado,
# integración con calculate_margin y validación de extracción.
EXPENSE_TRACKING_ENABLED=false

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Piper TTS ─────────────────────────────────────────────────
# Ruta al archivo .onnx del modelo Piper dentro del contenedor
PIPER_MODEL_PATH=/app/models/es_MX-claude-high.onnx
