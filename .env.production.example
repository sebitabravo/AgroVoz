# ──────────────────────────────────────────────────────────────────────
# AgroVoz — Variables de entorno de PRODUCCIÓN (ejemplo).
# Copiar a .env.production y completar con valores reales.
# .env.production NUNCA se commitea (está en .gitignore).
# Usar referencias a vault (1Password CLI / Doppler / Infisical) para secrets.
# ──────────────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=production
DEBUG=false

# ── Open-WA (gateway WhatsApp self-hosted) ──
# URL interna del contenedor Open-WA en el VPS.
OPENWA_API_URL=http://openwa:2785
# API key para autenticar llamadas al cliente Open-WA. Generar secreto fuerte.
OPENWA_API_KEY=
# Secreto compartido para validar firma HMAC del webhook entrante.
OPENWA_WEBHOOK_SECRET=

# ── OpenWeatherMap (clima) ──
# Plan gratuito: 60 llamadas/min. Suficiente para el piloto.
OPENWEATHER_API_KEY=

# ── Modelos de IA (rutas dentro del contenedor) ──
WHISPER_MODEL=small
LLM_MODEL_PATH=/app/models/qwen2.5-3b-instruct-q4_k_m.gguf
PIPER_VOICE=es_ES-carlfm-x_low

# ── Admin dashboard ──
# API key enviada en header X-Admin-Key. Generar secreto fuerte.
ADMIN_API_KEY=

# ── Seguridad y datos ──
# Rate limit por número de teléfono (requests/min).
RATE_LIMIT_PER_MINUTE=60
# Retención de audio temporal en el VPS (horas). Ley 21.719.
AUDIO_RETENTION_HOURS=24

# ── Deploy (variables de SSH al VPS, uso local en scripts) ──
VPS_HOST=agrovoz.cl
VPS_USER=ubuntu
