# AgroVoz — Git Attributes
# Normalización de line endings y configuración por tipo de archivo.
# Previene diffs basura por CRLF vs LF entre Windows, macOS y Linux.
# Docs: https://git-scm.com/docs/gitattributes

# ── Line endings ──
# Forzar LF en todo. Si alguien commitea desde Windows, git convierte CRLF → LF.
* text=auto eol=lf

# ── Binarios / archivos que git no debe diffear ──
*.db    binary
*.sqlite binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.svg   text
*.ico   binary
*.woff2 binary
*.gz    binary
*.zip   binary
*.tar   binary
*.whl   binary

# ── Detección de lenguaje en GitHub ──
# Los modelos descargados no son código nuestro.
backend/models/** linguist-vendored
backend/models/** -linguist-detectable

# ── Archivos de config ──
*.env.example text eol=lf
.env.production.example text eol=lf
Makefile text eol=lf

# ── Python ──
*.py text eol=lf diff=python

# ── Web ──
*.astro text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
