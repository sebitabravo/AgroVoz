# AgroVoz — Variables de entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitees .env al repo.

# ── Servidor ──────────────────────────
APP_ENV=development
APP_VERSION=0.1.0-dev
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── Base de datos ─────────────────────
DATABASE_URL=sqlite:///data/agrovoz.db

# ── Open-WA (gateway WhatsApp self-hosted) ──
# API key admin para autenticarse contra Open-WA (dashboard + API REST).
#
# En desarrollo la key está hardcodeada en docker-compose.yml: "dev-admin-key".
# No necesitás setear OPENWA_API_KEY a menos que quieras una key custom.
# Si la cambiás, editá docker-compose.yml y poné:
#   API_MASTER_KEY=${OPENWA_API_KEY:-dev-admin-key}
#
# IMPORTANTE: API_MASTER_KEY solo se usa en el PRIMER arranque (DB vacía).
# Si la DB ya tiene keys, se ignora en reinicios. Para resetear:
#   docker compose down && docker volume rm agrovoz_openwa_data
#
# Webhook Secret: validación HMAC de webhooks entrantes.
#   En desarrollo el default es "dev-webhook-secret" (docker-compose.yml).
#   En producción, generá un UUID v4: uuidgen | tr '[:upper:]' '[:lower:]'
# API URL: http://localhost:2785 desde el host (desarrollo sin Docker).
# Docker Compose sobreescribe a http://openwa:8000 automáticamente (red interna).
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=dev-webhook-secret
OPENWA_API_URL=http://localhost:2785

# ── OpenWeatherMap (DEPRECATED) ──────
# Migrado a OpenMeteo (issue #51). Sin API key.
# Se mantiene por compatibilidad, no afecta el funcionamiento.
OPENWEATHERMAP_API_KEY=

# ── ODEPA ────────────────────────────
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ───────────────────────
WHISPER_MODEL=small
# Directorio para modelos Whisper. Vacio = default ~/.cache/whisper/.
# En Docker, montar volumen en /app/models/whisper/.
WHISPER_MODEL_PATH=
LLM_MODEL_PATH=models/qwen2.5-3b-q4_k_m.gguf
PIPER_VOICE=es_MX-claude-high
# Ruta al archivo .onnx del modelo Piper. Descargar desde:
# https://huggingface.co/rhasspy/piper-voices/tree/main/es/es_MX/claude/high
# En Docker: /app/models/es_MX-claude-high.onnx
PIPER_MODEL_PATH=models/es_MX-claude-high.onnx

# ── OpenRouter (fallback LLM remoto, opcional) ──
# Vacio = fallback DESHABILITADO (comportamiento por defecto). Solo se usa
# si el LLM local (Qwen2.5-3B) no esta disponible o falla generando.
# Conseguir key gratis en https://openrouter.ai/settings/keys (no pide tarjeta).
# OJO antes de habilitar: los modelos gratuitos ("openrouter/free", un router
# que rota entre modelos segun disponibilidad) exigen, para poder usarse,
# aceptar en tu dashboard de OpenRouter que el contenido puede usarse para
# entrenar o publicarse. La consulta transcrita del agricultor saldria del
# VPS hacia un tercero no auditado — revisar antes de habilitar en produccion.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=12.0

# ── Admin ────────────────────────────
# API key para endpoints JSON del dashboard (header X-Admin-Key) y
# secret para firmar la cookie de sesión del login HTML (dashboard SSR).
# En desarrollo hay defaults seguros-en-local; en producción la app bloquea
# el arranque si se dejan los defaults. Generar con:
#   openssl rand -hex 32
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=

# ── Seguridad ────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUDIO_RETENTION_HOURS=24
PHONE_HASH_PEPPER=agrovoz-dev-pepper  # Cambiar por valor secreto en producción
# IPs/hosts extra separadas por coma para TrustedHostMiddleware.
# En desarrollo Docker, la IP de la red de Docker para webhooks de OpenWA.
EXTRA_ALLOWED_HOSTS=192.168.97.2

# ── Logging ───────────────────────────
LOG_LEVEL=DEBUG

# ── Tests E2E ─────────────────────────
# URL base de la API deployada para tests end-to-end.
# En desarrollo local, apunta al servidor uvicorn corriendo en :8000.
# En CI, se setea desde GitHub Actions secret.
AGROVOZ_E2E_BASE_URL=http://localhost:8000
# API key del admin para tests de autenticacion (X-Admin-Key).
# Debe coincidir con ADMIN_API_KEY de la instancia target.
AGROVOZ_E2E_ADMIN_KEY=dev-admin-key
# Timeout global para cada request E2E (segundos). Default: 30.
# Aumentar si la API deployada tiene cold start del LLM.
AGROVOZ_E2E_TIMEOUT=30
