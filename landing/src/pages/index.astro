    cta: "Hablar con ventas",
    featured: true,
    badge: "Recomendado",
    i18nName: "plan1.name",
    i18nSub: "plan1.sub",
    i18nUnit: "plan1.unit",
    i18nCta: "plan1.cta",
    i18nBadge: "plan1.badge",
    i18nFeatures: [
      "plan1.f1",
      "plan1.f2",
      "plan1.f3",
      "plan1.f4",
    ],
  },
  {
    plan: "premium",
    name: "Premium directo",
    sub: "Para el agricultor o la cooperativa",
