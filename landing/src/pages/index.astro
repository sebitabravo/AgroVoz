const impactoStats = [
  {
    count: 3500000,
    prefix: "+$",
    accent: true,
    label: "de ingreso adicional anual por productor (hasta), al negociar con datos",
    source: "Proyección AgroVoz",
    i18nLabel: "impacto.i1",
    i18nSource: "impacto.i1.src",
  },
  {
    count: 265000,
    label: "explotaciones de agricultura familiar — el 85% de los predios del país",
    source: "Fuente: INE / Censo Agropecuario",
    i18nLabel: "impacto.i2",
    i18nSource: "impacto.i2.src",
  },
  {
    text: "<15 s",
    label: "de latencia objetivo entre la pregunta y la respuesta de voz",
    source: "Objetivo AgroVoz",
    i18nLabel: "impacto.i3",
    i18nSource: "impacto.i3.src",
  },
];

const equipo = [
  {
    initials: "SB",
    name: "Sebastián Bravo",
    role: "Líder técnico",
    desc: "Arquitectura, backend, LLM y Tool Calling.",
    i18nRole: "equipo.sb.role",
    i18nDesc: "equipo.sb.desc",
  },
  {
    initials: "FF",
    name: "Francisco Fernández",
    role: "Product Owner",
    desc: "Producto, investigación y vínculo territorial en Traiguén.",
    i18nRole: "equipo.ff.role",
    i18nDesc: "equipo.ff.desc",
  },
  {
    initials: "MA",
    name: "Matías Atuán",
    role: "Desarrollo e investigación",
