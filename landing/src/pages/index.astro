    step: "01",
    title: "El productor pregunta",
    desc: "Envía un audio por WhatsApp en lenguaje natural: «¿A cuánto está la papa en Santiago?».",
    i18nTitle: "como.1.title",
    i18nDesc: "como.1.desc",
    delay: 0,
  },
  {
    step: "02",
    title: "AgroVoz consulta",
    desc: "Transcribe la voz, interpreta la pregunta y consulta fuentes oficiales —ODEPA y OpenMeteo— en tiempo real.",
    i18nTitle: "como.2.title",
    i18nDesc: "como.2.desc",
    delay: 120,
  },
  {
    step: "03",
    title: "Responde con voz",
    desc: "Devuelve un mensaje de audio en español natural con datos verificables, en menos de 15 segundos.",
    i18nTitle: "como.3.title",
    i18nDesc: "como.3.desc",
    delay: 240,
  },
