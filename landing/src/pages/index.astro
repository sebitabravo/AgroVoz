---

<Base>
  <Header />

  <main id="top">
    <Hero
      eyebrow="Inteligencia de precios y clima · por voz en WhatsApp"
      title="Tu voz tiene el precio justo."
      subtitle="AgroVoz convierte un mensaje de voz en WhatsApp en datos oficiales de mercado y clima, devueltos también por voz. Sin apps, sin leer ni escribir."
      ctaText="Solicitar una demo"
      ctaLink="#contacto"
      ctaSecondaryText="Ver cómo funciona"
      ctaSecondaryLink="#demo"
      meta="Voz vía WhatsApp · Precios ODEPA + clima en tiempo real · <15 s por respuesta"
      i18nEyebrow="hero.eyebrow"
      i18nTitle="hero.title"
      i18nSubtitle="hero.sub"
      i18nCtaText="hero.cta1"
      i18nCtaSecondary="hero.cta2"
      i18nMeta="hero.meta"
    />

    <!-- #problema -->
    <section class="section" id="problema">
      <div class="container" style="max-width:1080px">
        <div data-reveal>
          <span class="eyebrow" data-i18n="problema.eyebrow">El problema</span>
          <h2 class="h2" data-i18n="problema.title">
            Los precios existen. El acceso, no.
          </h2>
          <p class="lede" style="margin-top:20px" data-i18n="problema.body">
            ODEPA publica los precios mayoristas en un Excel. Pero el productor
            que negocia con un intermediario a las 6 AM no tiene cómo
            consultarlos. Esa asimetría de información le cuesta hasta el 60%
            del precio.
          </p>
        </div>
        <div class="stat-grid" style="margin-top:44px">
          {
            problemaStats.map((s) => (
              <StatCard
                count={s.count}
                decimals={s.decimals}
                prefix={s.prefix}
                suffix={s.suffix}
                text={s.text}
                accent={s.accent}
                label={s.label}
                source={s.source}
                i18nLabel={s.i18nLabel}
                i18nSource={s.i18nSource}
                revealDelay={s.delay}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #como -->
    <section class="section" id="como" style="background:var(--color-surface)">
      <div class="container">
        <div data-reveal style="text-align:center;margin-bottom:44px">
          <span class="eyebrow" data-i18n="como.eyebrow">Cómo funciona</span>
          <h2 class="h2" style="margin-inline:auto" data-i18n="como.title">
            Hablar es toda la interfaz.
          </h2>
        </div>
        <div class="grid-3">
          {
            pasos.map((p) => (
              <FeatureCard
                step={p.step}
                title={p.title}
                description={p.desc}
                i18nTitle={p.i18nTitle}
                i18nDescription={p.i18nDesc}
                revealDelay={p.delay}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #demo -->
    <section class="section" id="demo">
      <div class="container">
        <div class="demo-grid" id="demo-track">
          <div data-reveal>
            <span class="eyebrow" data-i18n="demo.eyebrow"
              >Una conversación real</span
            >
            <h2 class="h2" data-i18n="demo.title">
              Tan simple como un mensaje de voz.
            </h2>
            <p
              class="lede"
              style="margin-top:20px;max-width:46ch"
              data-i18n="demo.caption"
            >
              100% por voz. Sin apps, sin leer ni escribir — como mandarle un
              mensaje de voz a un vecino.
            </p>
            <div style="margin-top:32px">
              <Waveform variant="mini" />
            </div>
          </div>
          <DemoPhone />
        </div>
      </div>
    </section>

    <!-- #stack -->
    <section class="section" id="stack" style="background:var(--color-surface)">
      <div class="container">
        <div data-reveal style="max-width:720px">
          <span class="eyebrow" data-i18n="stack.eyebrow">Tecnología</span>
          <h2 class="h2" data-i18n="stack.title">
            Costos bajo control, por diseño.
          </h2>
          <p class="lede" style="margin-top:20px" data-i18n="stack.body">
            Whisper, el LLM y la síntesis de voz corren sobre tecnología
            open-source en infraestructura propia. No para regalar el servicio,
            sino para que sea rentable: el costo de operación no crece con cada
            nuevo agricultor.
          </p>
        </div>
        <div class="grid-stack" style="margin-top:44px">
          {
            stackItems.map((s) => (
              <FeatureCard
                variant="stack"
                title={s.title}
                subtitle={s.sub}
                icon={s.icon}
                i18nSubtitle={s.i18nSub}
              />
            ))
          }
        </div>
        <div class="cost-note" data-reveal>
          <span class="dot" aria-hidden="true"></span>
          <span data-i18n="stack.cost"
            >Costo de operación ≈ CLP 150–210 por agricultor/mes · margen bruto
            del 58–85%</span
          >
        </div>
      </div>
    </section>

    <!-- #planes -->
    <section class="section" id="planes">
      <div class="container">
        <div data-reveal style="text-align:center;max-width:760px;margin-inline:auto;margin-bottom:48px">
          <span class="eyebrow" data-i18n="planes.eyebrow">Planes</span>
          <h2 class="h2" style="margin-inline:auto" data-i18n="planes.title">
            Un plan para cada forma de llegar al agricultor.
          </h2>
          <p class="lede" style="margin:20px auto 0" data-i18n="planes.body">
            Desde el despliegue institucional hasta el servicio directo: elige
            cómo AgroVoz se ajusta a tu organización.
          </p>
        </div>
        <div class="grid-plans">
          {
            planes.map((p) => (
              <PlanCard
                plan={p.plan}
                name={p.name}
                sub={p.sub}
                price={p.price}
                unit={p.unit}
                features={p.features}
                cta={p.cta}
                featured={p.featured}
                badge={p.badge}
                i18nName={p.i18nName}
                i18nSub={p.i18nSub}
                i18nUnit={p.i18nUnit}
                i18nCta={p.i18nCta}
                i18nBadge={p.i18nBadge}
                i18nPrice={p.i18nPrice}
                i18nFeatures={p.i18nFeatures}
              />
            ))
          }
        </div>
        <p
          style="margin-top:32px;text-align:center;font-size:13.5px;color:var(--color-muted);max-width:60ch;margin-inline:auto"
          data-reveal data-i18n="planes.note"
        >
          El agricultor nunca paga en el plan institucional. Costo de operación
          ≈ CLP 150–210 por agricultor/mes.
        </p>
      </div>
    </section>

    <!-- #impacto -->
    <section class="section section--impacto" id="impacto">
      <div class="container" style="max-width:1080px">
        <div data-reveal>
          <span class="eyebrow" data-i18n="impacto.eyebrow">Impacto</span>
          <h2 class="h2" data-i18n="impacto.title">
            Cerrar la brecha cambia una economía familiar.
          </h2>
        </div>
        <div class="grid-3" style="margin-top:44px">
          {
            impactoStats.map((s) => (
              <StatCard
                variant="impact"
                count={s.count}
                prefix={s.prefix}
                text={s.text}
                accent={s.accent}
                label={s.label}
                source={s.source}
                i18nLabel={s.i18nLabel}
                i18nSource={s.i18nSource}
              />
            ))
          }
        </div>
        <div class="ods-bar" data-reveal>
          <span class="ods-numbers" data-i18n="impacto.odsNumbers"
            >ODS 2 · 8 · 10 · 13</span
          >
          <span class="ods-labels" data-i18n="impacto.odsLabels"
            >Hambre Cero · Trabajo Decente y Crecimiento · Reducción de
            Desigualdades · Acción por el Clima</span
          >
        </div>
      </div>
    </section>

    <!-- #equipo -->
    <section class="section" id="equipo">
      <div class="container">
        <div data-reveal style="text-align:center;margin-bottom:44px">
          <span class="eyebrow" data-i18n="equipo.eyebrow">Equipo</span>
          <h2 class="h2" style="margin-inline:auto" data-i18n="equipo.title">
            Estudiantes de Ingeniería en Informática, INACAP Temuco.
          </h2>
        </div>
        <div class="grid-3">
          {
            equipo.map((m) => (
              <TeamCard
                initials={m.initials}
                name={m.name}
                role={m.role}
                description={m.desc}
                i18nRole={m.i18nRole}
                i18nDescription={m.i18nDesc}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #contacto -->
    <section class="section" id="contacto" style="background:var(--color-surface)">
      <div class="container">
        <div class="contact-grid">
          <div data-reveal>
            <span class="eyebrow" data-i18n="contacto.eyebrow">Contacto</span>
            <h2 class="h2" data-i18n="contacto.title">
              Agenda una demo de AgroVoz.
            </h2>
            <p class="lede" style="margin-top:20px" data-i18n="contacto.body">
              Cuéntanos sobre tu organización y te mostramos AgroVoz funcionando
              con datos reales de tu zona. Para INDAP, PRODESAL, cooperativas,
              municipios y empresas del agro.
            </p>
            <p style="margin-top:24px;font-size:14.5px">
              <a
                href="mailto:hola@agrovoz.cl"
                style="color:var(--color-accent-deep);font-weight:600"
                data-i18n="contacto.alt"
                >O escríbenos a hola@agrovoz.cl</a
              >
            </p>
          </div>
          <div data-reveal>
            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  // --- AgroVoz landing: interactividad del lado cliente ---
  // Port fiel del JS del mockup (.dc.html): reveals, count-up, demo cascade,
  // parallax, selector de plan, i18n ES/EN y envio del form por mailto.

  const reduce = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // ===== Drawer de navegacion mobile (boton hamburguesa) =====
  const header = document.getElementById("site-header");
  const navToggle = document.getElementById("nav-toggle");
  const navBackdrop = document.getElementById("nav-backdrop");

  function setNav(open: boolean) {
    if (!header || !navToggle) return;
    header.classList.toggle("nav-open", open);
    navToggle.setAttribute("aria-expanded", open ? "true" : "false");
    navToggle.setAttribute(
      "aria-label",
      open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
    );
    document.body.style.overflow = open && window.innerWidth <= 920 ? "hidden" : "";
  }

  navToggle?.addEventListener("click", () =>
    setNav(!header?.classList.contains("nav-open")),
  );
  // Click en un enlace del menu cierra el drawer.
  document.querySelectorAll<HTMLElement>("#nav a").forEach((a) =>
    a.addEventListener("click", () => setNav(false)),
  );
  navBackdrop?.addEventListener("click", () => setNav(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setNav(false);
  });
  // Al volver a desktop, cierra y libera el scroll del fondo.
  window.matchMedia("(min-width: 921px)").addEventListener("change", (e) => {
    if (e.matches) setNav(false);
  });

  // ===== Diccionario EN (ES es la fuente de verdad en el markup) =====
  const EN: Record<string, string> = {
    "nav.como": "How it works",
    "nav.demo": "Demo",
    "nav.planes": "Plans",
    "nav.stack": "Technology",
    "nav.impacto": "Impact",
    "nav.contacto": "Contact",
    "hero.eyebrow": "Price and weather intelligence · by voice on WhatsApp",
    "hero.title": "Your voice gets the right price.",
    "hero.sub":
      "AgroVoz turns a WhatsApp voice message into official market and weather data, returned by voice. No apps, no reading or writing.",
    "hero.cta1": "Request a demo",
    "hero.cta2": "See how it works",
    "hero.meta":
      "Voice via WhatsApp · ODEPA prices + real-time weather · <15s per reply",
    "problema.eyebrow": "The problem",
    "problema.title": "The prices exist. Access doesn't.",
    "problema.body":
      "ODEPA publishes wholesale prices in a spreadsheet. But the smallholder negotiating with a middleman at 6 AM has no way to check them. That information gap costs up to 60% of the price.",
    "problema.s1": "INDAP-registered farmers in Chile",
    "problema.s2": "of the wholesale price captured by middlemen",
    "problema.s3": "average post-harvest losses",
    "problema.s4":
      "of climate adaptation is planned; the rest is guesswork",
    "problema.s1.src": "Source: INDAP, 2024",
    "problema.s2.src": "Source: ODEPA / FAO",
    "problema.s3.src": "Source: FAO",
    "problema.s4.src": "Source: FAO",
    "como.eyebrow": "How it works",
    "como.title": "Speaking is the whole interface.",
    "como.1.title": "The farmer asks",
    "como.1.desc":
      "Sends a voice note on WhatsApp in plain language: \"How much is potato in Santiago?\"",
    "como.2.title": "AgroVoz looks it up",
    "como.2.desc":
      "Transcribes the voice, understands the question and queries official sources — ODEPA and OpenMeteo — in real time.",
    "como.3.title": "Replies by voice",
    "como.3.desc":
      "Returns an audio message in natural Spanish with verifiable data, in under 15 seconds.",
    "demo.eyebrow": "A real conversation",
