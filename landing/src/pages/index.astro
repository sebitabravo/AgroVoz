  const ENPH: Record<string, string> = {
    "form.nameph": "Your name",
    "form.emailph": "your@email.com",
    "form.msgph": "How can we collaborate?",
  };

  // Captura el texto ES original de cada nodo i18n (fuente de verdad).
  document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
    el.dataset.es = el.textContent ?? "";
  });
  document.querySelectorAll<HTMLElement>("[data-i18n-ph]").forEach((el) => {
    const input = el as HTMLInputElement | HTMLTextAreaElement;
    el.dataset.esph = input.placeholder;
  });

  function setLang(lang: "es" | "en") {
    document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
      const key = el.dataset.i18n!;
      if (lang === "en" && EN[key]) el.textContent = EN[key];
      else el.textContent = el.dataset.es ?? "";
    });
    document.querySelectorAll<HTMLElement>("[data-i18n-ph]").forEach((el) => {
      const key = el.dataset.i18nPh!;
      const input = el as HTMLInputElement | HTMLTextAreaElement;
      if (lang === "en" && ENPH[key]) input.placeholder = ENPH[key];
      else input.placeholder = el.dataset.esph ?? "";
    });
    document.documentElement.lang = lang;
    document.querySelectorAll<HTMLButtonElement>("#lang-es,#lang-en").forEach(
      (b) => {
        b.classList.toggle("is-active", b.dataset.lang === lang);
      },
    );
    try {
      localStorage.setItem("agrovoz_lang", lang);
    } catch {
      /* localStorage puede estar bloqueado */
    }
  }

  document.querySelectorAll<HTMLButtonElement>("#lang-es,#lang-en").forEach(
    (b) => b.addEventListener("click", () => setLang(b.dataset.lang as "es" | "en")),
  );

  let initLang: "es" | "en" = "es";
  try {
    const stored = localStorage.getItem("agrovoz_lang");
    if (stored === "en" || stored === "es") initLang = stored;
  } catch {
    /* ignore */
  }
  setLang(initLang);

  // ===== Count-up =====
  function countUp(el: HTMLElement) {
    if (el.dataset.counted) return;
    el.dataset.counted = "1";
    const target = parseFloat(el.dataset.count ?? "");
    if (Number.isNaN(target)) return;
    const dec = parseInt(el.dataset.decimals ?? "0", 10);
    const pre = el.dataset.prefix ?? "";
    const suf = el.dataset.suffix ?? "";
    const fmt = (v: number) =>
      pre +
      new Intl.NumberFormat("es-CL", {
        minimumFractionDigits: dec,
        maximumFractionDigits: dec,
      }).format(v) +
      suf;
    if (reduce) {
      el.textContent = fmt(target);
      return;
    }
    const dur = 1500;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(target * e);
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = fmt(target);
    };
    requestAnimationFrame(tick);
  }

  // ===== Reveals on scroll =====
  const reveals = Array.from(
    document.querySelectorAll<HTMLElement>("[data-reveal]"),
  );

  function showNow(el: HTMLElement) {
    el.classList.add("is-visible");
    el.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
  }
  function hideEl(el: HTMLElement) {
    el.classList.remove("is-visible");
    el.querySelectorAll<HTMLElement>("[data-count]").forEach((n) => {
      // permite re-animar al volver a entrar
      delete n.dataset.counted;
    });
  }

  if (!reduce) {
    reveals.forEach((el) => {
      if (el.dataset.revealDelay)
        el.style.transitionDelay = el.dataset.revealDelay;
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) showNow(e.target as HTMLElement);
          else hideEl(e.target as HTMLElement);
        });
      },
      { threshold: 0, rootMargin: "0px 0px -8% 0px" },
    );
    reveals.forEach((el) => io.observe(el));
    // failsafe: revela lo que quedo en viewport sin disparar
    setTimeout(() => {
      reveals.forEach((el) => {
        const r = el.getBoundingClientRect();
        if (!el.classList.contains("is-visible") && r.top < window.innerHeight && r.bottom > 0)
          showNow(el);
      });
    }, 3500);
  } else {
    reveals.forEach(showNow);
  }

  // ===== Demo chat: cascada al entrar en viewport =====
  const track = document.getElementById("demo-track");
  const msgs = track
    ? Array.from(track.querySelectorAll<HTMLElement>("[data-msg]"))
    : [];
  let played = false;

  function playChat() {
    if (played) return;
    played = true;
    msgs.forEach((m, i) => {
      setTimeout(() => {
        if (played) m.classList.add("is-visible");
      }, 300 + i * 700);
    });
  }
  function resetChat() {
    played = false;
    msgs.forEach((m) => m.classList.remove("is-visible"));
  }

  if (reduce) {
    msgs.forEach((m) => m.classList.add("is-visible"));
  } else if (msgs.length && track) {
    const phone = document.getElementById("demo-phone") ?? track;
    const dio = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) playChat();
          else resetChat();
        });
      },
      { threshold: 0, rootMargin: "0px 0px -15% 0px" },
    );
    dio.observe(phone);
    setTimeout(() => {
      if (phone.getBoundingClientRect().top < window.innerHeight) playChat();
    }, 2500);
  }

  // ===== Parallax sutil =====
  const parallax = Array.from(
    document.querySelectorAll<HTMLElement>("[data-parallax]"),
  );
  function applyParallax() {
    if (reduce) return;
    parallax.forEach((el) => {
      const r = el.getBoundingClientRect();
      const center = r.top + r.height / 2 - window.innerHeight / 2;
      el.style.transform = `translateY(${
        center * parseFloat(el.dataset.parallax ?? "0") * 0.35
      }px)`;
    });
  }
  let ticking = false;
  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        applyParallax();
        ticking = false;
      });
      ticking = true;
    }
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  applyParallax();

  // ===== Selector de plan + envio del form por mailto =====
  let selectedPlan = "general";
  const chips = Array.from(
    document.querySelectorAll<HTMLElement>("[data-plan-chip]"),
  );

  function setPlan(p: string) {
    selectedPlan = p;
    chips.forEach((c) => {
      const on = c.dataset.planChip === p;
      c.style.background = on ? "var(--accent-soft)" : "var(--surface)";
      c.style.borderColor = on ? "var(--accent)" : "var(--line)";
      c.style.color = on ? "var(--accent-deep)" : "var(--muted)";
    });
  }
  chips.forEach((c) =>
    c.addEventListener("click", () => setPlan(c.dataset.planChip ?? "general")),
  );
  if (chips.length) setPlan("general");

  // un CTA de plan preselecciona ese plan antes de scroll al form
  document.querySelectorAll<HTMLElement>("[data-plan]").forEach((a) =>
    a.addEventListener("click", () =>
      setPlan(a.dataset.plan ?? "general"),
    ),
  );

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  if (form) {
    form.addEventListener("submit", (ev) => {
      ev.preventDefault();
      const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input, textarea",
      );
      const name = fields[0]?.value ?? "";
      const email = fields[1]?.value ?? "";
      const msg = fields[2]?.value ?? "";
      const activeChip = document.querySelector<HTMLElement>(
        `[data-plan-chip="${selectedPlan}"]`,
      );
      const planText = activeChip?.textContent ?? selectedPlan;
      const body = encodeURIComponent(
        `Plan de interés: ${planText}\n\n${msg}\n\n— ${name} (${email})`,
      );
      window.location.href =
        "mailto:hola@agrovoz.cl?subject=" +
        encodeURIComponent(`AgroVoz — ${planText} — ${name || "Contacto"}`) +
        "&body=" +
        body;
    });
  }
</script>
