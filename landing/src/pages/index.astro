---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import FeatureCard from "../components/FeatureCard.astro";
import StatCard from "../components/StatCard.astro";
import PlanCard from "../components/PlanCard.astro";
import TeamCard from "../components/TeamCard.astro";
import DemoPhone from "../components/DemoPhone.astro";
import ContactForm from "../components/ContactForm.astro";
import Waveform from "../components/Waveform.astro";

// --- Datos de las secciones (ES = fuente de verdad en el markup) ---

const problemaStats = [
  {
    count: 205000,
    label: "población objetivo estimada a partir de usuarios acreditados de INDAP",
    source: "Cruce INDAP–SII, abril 2026 · estimación interna por validar",
    i18nLabel: "problema.s1",
    i18nSource: "problema.s1.src",
    delay: 0,
  },
  {
    text: "40–60%",
    accent: true,
    label: "del precio mayorista capturado por intermediarios",
    source: "Fuente: ODEPA / FIA",
    i18nLabel: "problema.s2",
    i18nSource: "problema.s2.src",
    delay: 90,
  },
  {
    count: 14.5,
    decimals: 1,
    suffix: "%",
    label: "de pérdidas post-cosecha en promedio",
    source: "Fuente: estudio U. de Talca / FAO",
    i18nLabel: "problema.s3",
    i18nSource: "problema.s3.src",
    delay: 180,
  },
  {
    count: 7,
    suffix: "%",
    label: "de la adaptación climática es planificada; el resto es intuición",
    source: "Fuente: CR2 / MMA",
    i18nLabel: "problema.s4",
    i18nSource: "problema.s4.src",
    delay: 270,
  },
];

const pasos = [
  {
    step: "01",
    title: "El productor pregunta",
    desc: "Envía un audio por WhatsApp en lenguaje natural: «¿A cuánto está la papa en Santiago?».",
    i18nTitle: "como.1.title",
    i18nDesc: "como.1.desc",
    delay: 0,
  },
  {
    step: "02",
    title: "AgroVoz consulta",
    desc: "Transcribe la voz o procesa el texto, interpreta la pregunta y consulta fuentes oficiales. ODEPA se actualiza diariamente a las 06:00; el clima se actualiza con OpenMeteo.",
    i18nTitle: "como.2.title",
    i18nDesc: "como.2.desc",
    delay: 120,
  },
  {
    step: "03",
    title: "Responde por el mismo canal",
    desc: "Devuelve audio o texto en español natural con datos verificables. Objetivo: responder en menos de 15 segundos.",
    i18nTitle: "como.3.title",
    i18nDesc: "como.3.desc",
    delay: 240,
  },
];

const ecosystemItems = [
  {
    title: "Datos oficiales, no respuestas inventadas",
    subtitle: "ODEPA · Open-Meteo",
    description:
      "Precios agrícolas y clima localizado con fecha, unidad y fuente. Si el dato no está disponible, AgroVoz lo dice.",
    i18nTitle: "ecosistema.1.title",
    i18nSubtitle: "ecosistema.1.sub",
    i18nDescription: "ecosistema.1.desc",
  },
  {
    title: "Orientación conectada al territorio",
    subtitle: "INIA · INDAP · PRODESAL",
    description:
      "Calendarios y reglas de INIA con fuente y fecha, listos para probar en la demo web. Programas de INDAP y directorios se consultan por voz en WhatsApp, en etapa de piloto. Siempre con fuente y fecha.",
    i18nTitle: "ecosistema.2.title",
    i18nSubtitle: "ecosistema.2.sub",
    i18nDescription: "ecosistema.2.desc",
  },
  {
    title: "Un catálogo que se puede auditar",
    subtitle: "CIREN · INE · fuentes públicas",
    description:
      "Las fuentes conectadas y las que aún no tienen adaptador aparecen separadas. No prometemos trámites ni marketplace.",
    i18nTitle: "ecosistema.3.title",
    i18nSubtitle: "ecosistema.3.sub",
    i18nDescription: "ecosistema.3.desc",
  },
];

// Nota: card 1 usa Open-WA (gateway self-hosted). El mockup decia Twilio,
// pero el constraint del proyecto es 100% open-source, sin APIs pagas.
const SVG = (p: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;

const stackItems = [
  {
    title: "Open-WA",
    sub: "Canal de mensajería",
    i18nSub: "stack.1.sub",
    icon: SVG(
      '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
    ),
  },
  {
    title: "Whisper",
    sub: "Transcripción de voz",
    i18nSub: "stack.2.sub",
    icon: SVG(
      '<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="23"/><line x1="8" x2="16" y1="23" y2="23"/>',
    ),
  },
  {
    title: "Qwen2.5-3B",
    sub: "Comprensión + Tool Calling",
    i18nSub: "stack.3.sub",
    icon: SVG(
      '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" x2="9" y1="1" y2="4"/><line x1="15" x2="15" y1="1" y2="4"/><line x1="9" x2="9" y1="20" y2="23"/><line x1="15" x2="15" y1="20" y2="23"/><line x1="20" x2="23" y1="9" y2="9"/><line x1="20" x2="23" y1="14" y2="14"/><line x1="1" x2="4" y1="9" y2="9"/><line x1="1" x2="4" y1="14" y2="14"/>',
    ),
  },
  {
    title: "Piper TTS",
    sub: "Síntesis de voz",
    i18nSub: "stack.4.sub",
    icon: SVG(
      '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>',
    ),
  },
  {
    title: "ODEPA",
    sub: "Precios oficiales",
    i18nSub: "stack.5.sub",
    icon: SVG(
      '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
    ),
  },
  {
    title: "OpenMeteo",
    sub: "Clima localizado",
    i18nSub: "stack.6.sub",
    icon: SVG(
      '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
    ),
  },
];

const planes = [
  {
    plan: "institucional",
    name: "Institucional · B2G",
    sub: "Para INDAP, PRODESAL y municipios",
    price: "CLP 500–1.000",
    unit: "por agricultor · mes · precio de referencia",
    features: [
      "Gratis para el agricultor (subsidiado)",
      "Consultas de precios y clima (sujetas a límites operativos)",
      "Panel de cobertura y uso (en desarrollo)",
      "Onboarding en terreno",
    ],
    cta: "Hablar con ventas",
    featured: true,
    badge: "Recomendado",
    i18nName: "plan1.name",
    i18nSub: "plan1.sub",
    i18nUnit: "plan1.unit",
    i18nCta: "plan1.cta",
    i18nBadge: "plan1.badge",
    i18nFeatures: [
      "plan1.f1",
      "plan1.f2",
      "plan1.f3",
      "plan1.f4",
    ],
  },
  {
    plan: "convenios",
    name: "Convenios privados",
    sub: "Para empresas y gremios",
    price: "A convenir",
    unit: "según programa",
    features: [
      "Programas de proveedores AFC, RSE y cadena de proveedores",
      "Integración a medida",
    ],
    cta: "Conversemos",
    i18nName: "plan3.name",
    i18nSub: "plan3.sub",
    i18nUnit: "plan3.unit",
    i18nCta: "plan3.cta",
    i18nPrice: "plan3.price",
    i18nFeatures: ["plan3.f1", "plan3.f2"],
  },
];

const impactoStats = [
  {
    count: 3500000,
    prefix: "+$",
    accent: true,
    label: "de ingreso adicional anual por productor (hasta), al negociar con datos",
    source: "Proyección AgroVoz",
    i18nLabel: "impacto.i1",
    i18nSource: "impacto.i1.src",
  },
  {
    count: 265000,
    label: "explotaciones de agricultura familiar — hipótesis de contexto de mercado",
    source: "Censo Agropecuario 2021 · cifra por validar con fuente primaria versionada",
    i18nLabel: "impacto.i2",
    i18nSource: "impacto.i2.src",
  },
  {
    text: "<15 s",
    label: "de latencia objetivo entre la pregunta y la respuesta de voz",
    source: "Objetivo AgroVoz",
    i18nLabel: "impacto.i3",
    i18nSource: "impacto.i3.src",
  },
];

const equipo = [
  {
    initials: "SB",
    name: "Sebastián Bravo",
    role: "Diseño, desarrollo y producto",
    desc: "Arquitectura, backend, LLM, Tool Calling y producto.",
    i18nRole: "equipo.sb.role",
    i18nDesc: "equipo.sb.desc",
  },
];
---

<Base>
  <Header />

  <main id="top">
    <Hero
      eyebrow="Inteligencia de precios y clima · por voz en WhatsApp"
      title="Tu voz tiene el precio justo."
      subtitle="AgroVoz convierte un mensaje de voz o texto en WhatsApp en datos oficiales de mercado y clima, devueltos por el mismo canal. Sin apps ni instalaciones."
      ctaText="Probar la demo"
      ctaLink="/demo"
      ctaSecondaryText="Solicitar una demo"
      ctaSecondaryLink="#contacto"
      meta="Precios ODEPA con fecha visible + clima actualizado · respuesta en <15 s (objetivo) · WhatsApp en piloto"
      i18nEyebrow="hero.eyebrow"
      i18nTitle="hero.title"
      i18nSubtitle="hero.sub"
      i18nCtaText="hero.cta1"
      i18nCtaSecondary="hero.cta2"
      i18nMeta="hero.meta"
    />

    <!-- #problema -->
    <section class="section" id="problema">
      <div class="container" style="max-width:1080px">
        <div data-reveal>
          <span class="eyebrow" data-i18n="problema.eyebrow">El problema</span>
          <h2 class="h2" data-i18n="problema.title">
            Los precios existen. El acceso, no.
          </h2>
          <p class="lede" style="margin-top:20px" data-i18n="problema.body">
            ODEPA publica los precios mayoristas en un Excel. Pero el productor
            que negocia con un intermediario a las 6 AM no tiene cómo
            consultarlos. Esa asimetría de información le cuesta hasta el 60%
            del precio.
          </p>
        </div>
        <div class="stat-grid" style="margin-top:44px">
          {
            problemaStats.map((s) => (
              <StatCard
                count={s.count}
                decimals={s.decimals}
                prefix={s.prefix}
                suffix={s.suffix}
                text={s.text}
                accent={s.accent}
                label={s.label}
                source={s.source}
                i18nLabel={s.i18nLabel}
                i18nSource={s.i18nSource}
                revealDelay={s.delay}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #como -->
    <section class="section" id="como" style="background:var(--color-surface)">
      <div class="container">
        <div data-reveal style="text-align:center;margin-bottom:44px">
          <span class="eyebrow" data-i18n="como.eyebrow">Cómo funciona</span>
          <h2 class="h2" style="margin-inline:auto" data-i18n="como.title">
            Hablar es toda la interfaz.
          </h2>
        </div>
        <div class="grid-3">
          {
            pasos.map((p) => (
              <FeatureCard
                step={p.step}
                title={p.title}
                description={p.desc}
                i18nTitle={p.i18nTitle}
                i18nDescription={p.i18nDesc}
                revealDelay={p.delay}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #demo -->
    <section class="section" id="demo">
      <div class="container">
        <div class="demo-grid" id="demo-track">
          <div data-reveal>
            <span class="eyebrow" data-i18n="demo.eyebrow"
              >Así se ve la conversación</span
            >
            <h2 class="h2" data-i18n="demo.title">
              Tan simple como un mensaje de WhatsApp.
            </h2>
            <p
              class="lede"
              style="margin-top:20px;max-width:46ch"
              data-i18n="demo.caption"
            >
              La vista previa es un ejemplo del formato de respuesta; la demo
              interactiva consulta precios y clima con datos vivos.
            </p>
            <div style="margin-top:32px">
              <Waveform variant="mini" />
            </div>
            {/* Enlace a la demo interactiva: sin esto /demo queda huerfana,
                no habia forma de llegar desde el sitio. */}
            <div style="margin-top:28px">
              <a href="/demo" class="btn btn-primary" data-i18n="demo.cta">
                Probar la demo interactiva
              </a>
            </div>
          </div>
          <DemoPhone />
        </div>
      </div>
    </section>

    <!-- #ecosistema -->
    <section class="section" id="ecosistema" style="background:var(--color-surface)">
      <div class="container">
        <div data-reveal style="max-width:760px">
          <span class="eyebrow" data-i18n="ecosistema.eyebrow">Ecosistema agrícola</span>
          <h2 class="h2" data-i18n="ecosistema.title">
            La información fragmentada, en una sola conversación.
          </h2>
          <p class="lede" style="margin-top:20px" data-i18n="ecosistema.body">
            AgroVoz no reemplaza a las instituciones ni vende productos: ordena
            fuentes oficiales y las acerca al agricultor por WhatsApp.
          </p>
        </div>
        <div class="grid-3" style="margin-top:44px">
          {
            ecosystemItems.map((item) => (
              <FeatureCard
                title={item.title}
                subtitle={item.subtitle}
                description={item.description}
                i18nTitle={item.i18nTitle}
                i18nSubtitle={item.i18nSubtitle}
                i18nDescription={item.i18nDescription}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #stack -->
    <section class="section" id="stack" style="background:var(--color-surface)">
      <div class="container">
        <div data-reveal style="max-width:720px">
          <span class="eyebrow" data-i18n="stack.eyebrow">Tecnología</span>
          <h2 class="h2" data-i18n="stack.title">
            Costos bajo control, por diseño.
          </h2>
          <p class="lede" style="margin-top:20px" data-i18n="stack.body">
            Whisper, Piper y el modelo Qwen son open-source y pueden correr en
            infraestructura propia. El LLM principal se conecta a un proveedor
            en la nube, configurable, y el modelo local queda como respaldo
            obligatorio si falla. Modelos abiertos, sin depender de una sola
            nube.
          </p>
        </div>
        <div class="grid-stack" style="margin-top:44px">
          {
            stackItems.map((s) => (
              <FeatureCard
                variant="stack"
                title={s.title}
                subtitle={s.sub}
                icon={s.icon}
                i18nSubtitle={s.i18nSub}
              />
            ))
          }
        </div>
        <div class="cost-note" data-reveal>
          <span class="dot" aria-hidden="true"></span>
          <span data-i18n="stack.cost"
            >Costo base de operación: CLP 14.364/mes · costo por uso solo si el
            LLM corre en la nube · fallback local sin costo</span
          >
        </div>
      </div>
    </section>

    <!-- #planes -->
    <section class="section" id="planes">
      <div class="container">
        <div data-reveal style="text-align:center;max-width:760px;margin-inline:auto;margin-bottom:48px">
          <span class="eyebrow" data-i18n="planes.eyebrow">Planes</span>
          <h2 class="h2" style="margin-inline:auto" data-i18n="planes.title">
            Un plan para cada forma de llegar al agricultor.
          </h2>
          <p class="lede" style="margin:20px auto 0" data-i18n="planes.body">
            Desde el despliegue institucional hasta convenios privados: elige
            cómo AgroVoz se integra a tu organización.
          </p>
        </div>
        <div class="grid-plans">
          {
            planes.map((p) => (
              <PlanCard
                plan={p.plan}
                name={p.name}
                sub={p.sub}
                price={p.price}
                unit={p.unit}
                features={p.features}
                cta={p.cta}
                featured={p.featured}
                badge={p.badge}
                i18nName={p.i18nName}
                i18nSub={p.i18nSub}
                i18nUnit={p.i18nUnit}
                i18nCta={p.i18nCta}
                i18nBadge={p.i18nBadge}
                i18nPrice={p.i18nPrice}
                i18nFeatures={p.i18nFeatures}
              />
            ))
          }
        </div>
        <p
          style="margin-top:32px;text-align:center;font-size:13.5px;color:var(--color-muted);max-width:60ch;margin-inline:auto"
          data-reveal data-i18n="planes.note"
        >
          El agricultor nunca paga. El costo base de operación es CLP 14.364 al
          mes; el LLM en la nube suma costo por uso.
        </p>
      </div>
    </section>

    <!-- #impacto -->
    <section class="section section--impacto" id="impacto">
      <div class="container" style="max-width:1080px">
        <div data-reveal>
          <span class="eyebrow" data-i18n="impacto.eyebrow">Impacto</span>
          <h2 class="h2" data-i18n="impacto.title">
            Cerrar la brecha cambia una economía familiar.
          </h2>
        </div>
        <div class="grid-3" style="margin-top:44px">
          {
            impactoStats.map((s) => (
              <StatCard
                variant="impact"
                count={s.count}
                prefix={s.prefix}
                text={s.text}
                accent={s.accent}
                label={s.label}
                source={s.source}
                i18nLabel={s.i18nLabel}
                i18nSource={s.i18nSource}
              />
            ))
          }
        </div>
        <div class="ods-bar" data-reveal>
          <span class="ods-numbers" data-i18n="impacto.odsNumbers"
            >ODS 2 · 8 · 10 · 13</span
          >
          <span class="ods-labels" data-i18n="impacto.odsLabels"
            >Hambre Cero · Trabajo Decente y Crecimiento · Reducción de
            Desigualdades · Acción por el Clima</span
          >
        </div>
      </div>
    </section>

    <!-- #equipo -->
    <section class="section" id="equipo">
      <div class="container">
        <div data-reveal style="text-align:center;margin-bottom:44px">
          <span class="eyebrow" data-i18n="equipo.eyebrow">Equipo</span>
          <h2 class="h2" style="margin-inline:auto" data-i18n="equipo.title">
            Estudiante de Ingeniería en Informática, INACAP Temuco.
          </h2>
        </div>
        <div class="grid-3">
          {
            equipo.map((m) => (
              <TeamCard
                initials={m.initials}
                name={m.name}
                role={m.role}
                description={m.desc}
                i18nRole={m.i18nRole}
                i18nDescription={m.i18nDesc}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- #contacto -->
    <section class="section" id="contacto" style="background:var(--color-surface)">
      <div class="container">
        <div class="contact-grid">
          <div data-reveal>
            <span class="eyebrow" data-i18n="contacto.eyebrow">Contacto</span>
            <h2 class="h2" data-i18n="contacto.title">
              Agenda una demo de AgroVoz.
            </h2>
            <p class="lede" style="margin-top:20px" data-i18n="contacto.body">
              Cuéntanos sobre tu organización y te mostramos AgroVoz funcionando
              con datos reales de tu zona. Para INDAP, PRODESAL, cooperativas,
              municipios y empresas del agro.
            </p>
          </div>
          <div data-reveal>
            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  // --- AgroVoz landing: interactividad del lado cliente ---
  // Port fiel del JS del mockup (.dc.html): reveals, count-up, demo cascade,
  // parallax, selector de plan, i18n ES/EN y envio seguro del formulario.

  const reduce = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // ===== Diccionario EN (ES es la fuente de verdad en el markup) =====
  const EN: Record<string, string> = {
    "nav.como": "How it works",
    "nav.demo": "Demo",
    "nav.ecosistema": "Ecosystem",
    "nav.planes": "Plans",
    "nav.stack": "Technology",
    "nav.impacto": "Impact",
    "nav.contacto": "Contact",
    "hero.eyebrow": "Price and weather intelligence · by voice on WhatsApp",
    "hero.title": "Your voice gets the right price.",
    "hero.sub":
      "AgroVoz turns a WhatsApp voice message or text into official market and weather data, returned through the same channel. No app installation.",
    "hero.cta1": "Try the demo",
    "hero.cta2": "Request a demo",
    "hero.meta":
      "ODEPA prices with visible date + updated weather · reply in under 15s (target) · WhatsApp in pilot",
    "problema.eyebrow": "The problem",
    "problema.title": "The prices exist. Access doesn't.",
    "problema.body":
      "ODEPA publishes wholesale prices in a spreadsheet. But the smallholder negotiating with a middleman at 6 AM has no way to check them. That information gap costs up to 60% of the price.",
    "problema.s1": "estimated target population from accredited INDAP users",
    "problema.s2": "of the wholesale price captured by middlemen",
    "problema.s3": "average post-harvest losses",
    "problema.s4":
      "of climate adaptation is planned; the rest is guesswork",
    "problema.s1.src": "INDAP–SII cross-check, April 2026 · internal estimate pending validation",
    "problema.s2.src": "Source: ODEPA / FIA",
    "problema.s3.src": "Source: University of Talca study / FAO",
    "problema.s4.src": "Source: CR2 / Ministry of Environment",
    "como.eyebrow": "How it works",
    "como.title": "Speaking is the whole interface.",
    "como.1.title": "The farmer asks",
    "como.1.desc":
      "Sends a voice note on WhatsApp in plain language: \"How much is potato in Santiago?\"",
