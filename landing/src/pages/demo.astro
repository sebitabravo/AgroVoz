---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Demo Interactiva — AgroVoz";
const pageDescription = "Prueba AgroVoz desde el navegador. Escribe una pregunta sobre precios agrícolas o clima y recibe la respuesta por voz.";
---

<Base title={pageTitle} description={pageDescription}>
  <Header showLanguageToggle={false} />
  {/* id="top": destino del skip link de Base.astro. Sin esto, "Saltar al
      contenido principal" no llevaba a ningun lado en esta pagina. */}
  <main id="top">
    <!-- Hero alineado al patron del landing (Hero.astro): section + container,
         eyebrow-pill + h1 + lede. La tipografia vive en global.css. -->
    <section class="section" style="text-align:center">
      <div class="container" style="max-width:1080px">
        <span class="eyebrow-pill">
          <span class="dot" aria-hidden="true" />
          Demo interactiva
        </span>
        <h1 class="h1" style="margin-inline:auto">Habla con AgroVoz.</h1>
        <p class="lede" style="margin:28px auto 0">
          Como una conversación de WhatsApp, pero con datos agrícolas oficiales.
          Escribe una pregunta y mira cómo responde.
        </p>
      </div>
    </section>

    <section class="demo-chat-section" aria-label="Chat de demostración">
      <div class="demo-chat-layout">
        <div class="demo-chat-copy">
          <span class="demo-copy__eyebrow">Así funciona</span>
          <h2 class="h2" style="max-width:470px;margin:0 0 1.25rem">
            Tu consulta entra como un mensaje. La respuesta también.
          </h2>
          <p class="lede" style="max-width:420px">
            Prueba precios de ODEPA o el pronóstico de OpenMeteo. No necesitas
            instalar una app ni crear una cuenta.
          </p>

          <div class="demo-proof-list" aria-label="Características de la demo">
            <div class="demo-proof-item">
              <span class="demo-proof-item__icon" aria-hidden="true">✓</span>
              <span><strong>Fuente visible</strong><small>Fecha, unidad y origen del dato.</small></span>
            </div>
            <div class="demo-proof-item">
              <span class="demo-proof-item__icon" aria-hidden="true">◌</span>
              <span><strong>Respuesta por voz</strong><small>Escúchala en este mismo teléfono.</small></span>
            </div>
          </div>

          <div class="demo-suggestions">
            <span class="demo-suggestions__label">Prueba una consulta</span>
            <div class="demo-suggestions__list">
              <button type="button" data-demo-prompt="¿A cuánto está la papa?">Precio de la papa <span>↗</span></button>
              <button type="button" data-demo-prompt="¿Va a llover en Traiguén mañana?">Clima en Traiguén <span>↗</span></button>
              <button type="button" data-demo-prompt="¿Cuál es el precio del tomate?">Precio del tomate <span>↗</span></button>
              <button type="button" data-demo-prompt="¿Cuál es el calendario agrícola del tomate?">Calendario del tomate <span>↗</span></button>
              <button type="button" data-demo-prompt="¿Qué hago si mis papas tienen manchas en las hojas?">Manchas en las papas <span>↗</span></button>
              <button type="button" data-demo-prompt="¿Cuándo se siembra el trigo en Traiguén?">Siembra del trigo <span>↗</span></button>
            </div>
          </div>
        </div>

        <div class="demo-device-wrap">
          <div class="demo-device" aria-label="Teléfono simulado con una conversación de WhatsApp">
            <div class="demo-device__side-button demo-device__side-button--top" aria-hidden="true"></div>
            <div class="demo-device__side-button demo-device__side-button--middle" aria-hidden="true"></div>
            <div class="demo-device__camera" aria-hidden="true"></div>
            <div class="demo-device__screen">
              <div class="demo-device__statusbar" aria-hidden="true">
                <span>9:41</span>
                <span class="demo-device__status-icons">● ◼︎ ▰</span>
              </div>

              <div class="chat-header">
                <span class="chat-header__back" aria-hidden="true">‹</span>
                <div class="chat-header__avatar" aria-hidden="true">A</div>
                <div class="chat-header__info">
                  <span class="chat-header__name">AgroVoz</span>
                  <span class="chat-header__status" id="chat-status"><span class="chat-header__online-dot"></span>en línea</span>
                </div>
                <div class="chat-header__actions" aria-hidden="true"><span>⌕</span><span>⋮</span></div>
              </div>

              <div class="chat-messages" id="chat-messages" role="log" aria-live="polite" aria-label="Conversación">
                <div class="chat-date-divider"><span>Hoy</span></div>

                <div class="chat-bubble chat-bubble--received">
                  <div class="chat-bubble__text">
                    ¡Hola! Soy AgroVoz. Pregúntame por el precio de un
                    producto, el clima de Traiguén o el calendario y las
                    reglas de cultivo según INIA.
                  </div>
                  <span class="chat-bubble__time">Ahora</span>
                </div>

                <div class="chat-bubble chat-bubble--received">
                  <div class="chat-bubble__text">
                    Prueba con:
                    <ul>
                      <li>¿A cuánto está la papa?</li>
                      <li>¿Va a llover en Traiguén mañana?</li>
                      <li>¿Cuál es el precio del tomate?</li>
                      <li>¿Cuál es el calendario agrícola del tomate?</li>
                      <li>¿Qué hago si mis papas tienen manchas en las hojas?</li>
                      <li>¿Cuándo se siembra el trigo en Traiguén?</li>
                    </ul>
                  </div>
                  <span class="chat-bubble__time">Ahora</span>
                </div>
              </div>

              <div class="chat-input-bar">
                <form id="chat-form" class="chat-form" autocomplete="off">
                  <span class="chat-compose-icon" aria-hidden="true">☺</span>
                  <input
                    type="text"
                    id="chat-input"
                    class="chat-input"
                    placeholder="Escribe tu pregunta..."
                    maxlength="500"
                    aria-label="Escribe tu consulta"
                  />
                  <button
                    type="button"
                    id="chat-mic"
                    class="chat-mic-btn"
                    aria-label="Grabar consulta de voz"
                    title="Grabar consulta de voz"
                  >
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="2" width="6" height="12" rx="3"></rect>
                      <path d="M5 10a7 7 0 0 0 14 0"></path>
                      <line x1="12" y1="19" x2="12" y2="22"></line>
                      <line x1="8" y1="22" x2="16" y2="22"></line>
                    </svg>
                  </button>
                  <button
                    type="submit"
                    id="chat-send"
                    class="chat-send-btn"
                    aria-label="Enviar consulta"
                    disabled
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="22" y1="2" x2="11" y2="13"></line>
                      <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                  </button>
                </form>
              </div>
            </div>
          </div>
          <p class="demo-device-caption"><span class="demo-device-caption__lock">⌁</span> Vista simulada · La demo conectada usa datos reales</p>
        </div>
      </div>

      <section class="demo-live-data" aria-labelledby="demo-live-title">
        <div class="demo-live-data__header">
          <div>
            <span class="demo-copy__eyebrow">Conexiones en vivo</span>
            <h2 id="demo-live-title" class="h2">No es solo una maqueta.</h2>
          </div>
          <p>Estas tarjetas consultan directamente los endpoints públicos del backend para mostrar la fecha, el origen y el estado de los datos.</p>
        </div>
        <div class="demo-live-grid">
          <article class="demo-live-card">
            <div class="demo-live-card__top"><span class="demo-live-card__number">01</span><span class="demo-live-card__status" aria-hidden="true"></span></div>
            <h3>Precios ODEPA</h3>
            <p>Precio actual de un producto en los mercados disponibles, como ejemplo.</p>
            <select id="live-price-product" class="demo-live-card__select" aria-label="Producto para consultar su precio">
              <option value="papa" selected>papa</option>
            </select>
            <button type="button" class="demo-live-card__button" data-live-action="price">Ver precios actuales <span aria-hidden="true">→</span></button>
            <div id="live-price-result" class="demo-live-card__result" role="status" aria-live="polite">Aún no consultado.</div>
          </article>
          <article class="demo-live-card">
            <div class="demo-live-card__top"><span class="demo-live-card__number">02</span><span class="demo-live-card__status" aria-hidden="true"></span></div>
            <h3>Clima en Traiguén</h3>
            <p>Lee la condición actual desde OpenMeteo.</p>
            <button type="button" class="demo-live-card__button" data-live-action="weather">Consultar clima <span aria-hidden="true">→</span></button>
            <div id="live-weather-result" class="demo-live-card__result" role="status" aria-live="polite">Aún no consultado.</div>
          </article>
          <article class="demo-live-card">
            <div class="demo-live-card__top"><span class="demo-live-card__number">03</span><span class="demo-live-card__status" aria-hidden="true"></span></div>
            <h3>Fuentes conectadas</h3>
            <p>Revisa cobertura, vigencia y estado del catálogo.</p>
            <button type="button" class="demo-live-card__button" data-live-action="sources">Ver catálogo <span aria-hidden="true">→</span></button>
            <div id="live-sources-result" class="demo-live-card__result" role="status" aria-live="polite">Aún no consultado.</div>
          </article>
        </div>
      </section>

      <div id="demo-state" class="demo-state" role="status" hidden>
        <span id="demo-state-text"></span>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const form = document.getElementById("chat-form") as HTMLFormElement;
  const input = document.getElementById("chat-input") as HTMLInputElement;
  const sendBtn = document.getElementById("chat-send") as HTMLButtonElement;
  const micBtn = document.getElementById("chat-mic") as HTMLButtonElement;
  const messages = document.getElementById("chat-messages") as HTMLDivElement;
  const statusEl = document.getElementById("chat-status") as HTMLSpanElement;
  const stateEl = document.getElementById("demo-state") as HTMLDivElement;
  const stateText = document.getElementById("demo-state-text") as HTMLSpanElement;
  const productSelect = document.getElementById("live-price-product") as HTMLSelectElement;

  let loading = false;
  // Entre el click y el resolve de getUserMedia no hay recorder todavia; este
  // flag síncrono evita pedir un segundo stream en ese lapso (fuga de micrófono).
  let starting = false;
  let recorder: MediaRecorder | null = null;
  let recorderStream: MediaStream | null = null;
  let recordingChunks: BlobPart[] = [];
  let recordingTimeout: number | undefined;
  let typingBubble: HTMLDivElement | null = null;
  type DemoHistoryMessage = { rol: "user" | "assistant"; texto: string };
  const chatHistory: DemoHistoryMessage[] = [];

  function setChatStatus(label: string) {
    statusEl.textContent = "";
    if (label === "en línea") {
      const dot = document.createElement("span");
      dot.className = "chat-header__online-dot";
      statusEl.append(dot);
    }
    statusEl.append(label);
  }

  function updateComposerState() {
    sendBtn.disabled = input.value.trim().length === 0 || loading;
    micBtn.disabled = loading;
  }

  input.addEventListener("input", updateComposerState);

  function setLoading(msg: string) {
    loading = true;
    sendBtn.disabled = true;
    micBtn.disabled = true;
    setChatStatus("escribiendo...");
    addTypingBubble();
    stateEl.hidden = false;
    stateText.textContent = msg;
  }

  function addTypingBubble() {
    if (typingBubble) return;

    typingBubble = document.createElement("div");
    typingBubble.className = "chat-bubble chat-bubble--received chat-bubble--typing";
    typingBubble.setAttribute("role", "status");
    typingBubble.setAttribute("aria-label", "AgroVoz está escribiendo");

    const dots = document.createElement("span");
    dots.className = "chat-typing-dots";
    dots.setAttribute("aria-hidden", "true");
    dots.append(document.createElement("span"), document.createElement("span"), document.createElement("span"));
    typingBubble.appendChild(dots);
    messages.appendChild(typingBubble);
    messages.scrollTop = messages.scrollHeight;
  }

  function removeTypingBubble() {
    typingBubble?.remove();
    typingBubble = null;
  }

  function clearLoading() {
    removeTypingBubble();
    loading = false;
    updateComposerState();
    setChatStatus("en línea");
    stateEl.hidden = true;
  }

  function showError(msg: string) {
    removeTypingBubble();
    loading = false;
    updateComposerState();
    setChatStatus("en línea");
    stateEl.hidden = false;
    stateText.textContent = msg;
    stateEl.classList.add("demo-state--error");
    setTimeout(() => {
      stateEl.hidden = true;
      stateEl.classList.remove("demo-state--error");
    }, 6000);
  }

  function rememberTurn(rol: "user" | "assistant", texto: string) {
    // El backend limita cada turno de historial a 500 caracteres. Las
    // respuestas agronómicas traen fuentes largas, así que recortamos solo el
    // contexto enviado en la siguiente consulta, no la burbuja visible.
    chatHistory.push({ rol, texto: texto.slice(0, 500) });
    if (chatHistory.length > 6) chatHistory.splice(0, chatHistory.length - 6);
  }

  function apiErrorMessage(detail: unknown): string {
    if (typeof detail === "string" && detail.trim()) return detail;
    if (Array.isArray(detail)) {
      const messages = detail.flatMap((item) => {
        if (item && typeof item === "object" && "msg" in item && typeof item.msg === "string") {
          return [item.msg];
        }
        return [];
      });
      if (messages.length > 0) return messages.join(" ");
    }
    if (detail && typeof detail === "object" && "message" in detail && typeof detail.message === "string") {
      return detail.message;
    }
    return "Error al procesar tu consulta.";
  }

  function addVoiceBubble() {
    const bubble = document.createElement("div");
    bubble.className = "chat-bubble chat-bubble--sent chat-bubble--voice";

    const voice = document.createElement("div");
    voice.className = "chat-voice-message";
    voice.innerHTML = `
      <span class="chat-voice-message__icon" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0"></path></svg>
      </span>
      <span class="chat-voice-message__label">Mensaje de voz</span>
      <span class="chat-voice-message__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
    `;

    const timeSpan = document.createElement("span");
    timeSpan.className = "chat-bubble__time";
    timeSpan.textContent = new Date().toLocaleTimeString("es-CL", {
      hour: "2-digit",
      minute: "2-digit",
    });
    bubble.append(voice, timeSpan);
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  }

  function addBubble(
    text: string,
    side: "sent" | "received",
    time?: string,
    audioB64?: string,
  ) {
    const bubble = document.createElement("div");
    bubble.className = "chat-bubble chat-bubble--" + side;

    const textDiv = document.createElement("div");
    textDiv.className = "chat-bubble__text";
    textDiv.textContent = text;

    const timeSpan = document.createElement("span");
    timeSpan.className = "chat-bubble__time";
    timeSpan.textContent = time || new Date().toLocaleTimeString("es-CL", {
      hour: "2-digit",
      minute: "2-digit",
    });

    bubble.appendChild(textDiv);

    if (side === "received" && text.trim()) {
      const audioContainer = document.createElement("div");
      audioContainer.className = "chat-audio-player";

      const iconPlay =
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg> Escuchar';
      const iconPause =
        '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg> Pausar';

      const playBtn = document.createElement("button");
      playBtn.className = "chat-audio-btn";
      playBtn.type = "button";
      playBtn.setAttribute("aria-label", "Reproducir audio de respuesta");
      playBtn.innerHTML = iconPlay;

      if (audioB64) {
        // Voz real de Piper TTS (deploy con pipeline completo: Docker/local).
        let audio: HTMLAudioElement | null = null;
        playBtn.addEventListener("click", () => {
          if (audio) {
            if (audio.paused) {
              audio.play();
              playBtn.innerHTML = iconPause;
            } else {
              audio.pause();
              playBtn.innerHTML = iconPlay;
            }
            return;
          }
          const byteChars = atob(audioB64);
          const byteNums = new Array(byteChars.length);
          for (let i = 0; i < byteChars.length; i++) {
            byteNums[i] = byteChars.charCodeAt(i);
          }
          const blob = new Blob([new Uint8Array(byteNums)], {
            type: "audio/ogg; codecs=opus",
          });
          audio = new Audio(URL.createObjectURL(blob));
          audio.play();
          playBtn.innerHTML = iconPause;
          audio.addEventListener("ended", () => {
            playBtn.innerHTML = iconPlay;
            audio = null;
          });
        });
      } else if ("speechSynthesis" in window) {
        // Sin Piper (deploy slim en Vercel: sin modelos locales), la demo
        // sigue hablando con el sintetizador del navegador. No es la voz de
        // producción — la etiqueta del botón lo deja explícito.
        playBtn.setAttribute("aria-label", "Reproducir con voz del navegador");
        playBtn.addEventListener("click", () => {
          if (window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
            playBtn.innerHTML = iconPlay;
            return;
          }
          const utterance = new SpeechSynthesisUtterance(text);
          utterance.lang = "es-CL";
          utterance.onend = () => {
            playBtn.innerHTML = iconPlay;
          };
          playBtn.innerHTML = iconPause;
          window.speechSynthesis.speak(utterance);
        });
      } else {
        playBtn.disabled = true;
        playBtn.title = "Este navegador no soporta síntesis de voz";
      }

      audioContainer.appendChild(playBtn);
      bubble.appendChild(audioContainer);
    }

    bubble.appendChild(timeSpan);
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  }

  function addRetryBubble(text: string, retryText: string, retryVoice = false) {
    const bubble = document.createElement("div");
    bubble.className = "chat-bubble chat-bubble--received chat-bubble--error";

    const textDiv = document.createElement("div");
    textDiv.className = "chat-bubble__text";
    textDiv.textContent = text;

    const retryBtn = document.createElement("button");
    retryBtn.className = "chat-retry-btn";
    retryBtn.type = "button";
    retryBtn.textContent = retryVoice ? "Grabar de nuevo" : "Reintentar";
    retryBtn.addEventListener("click", () => {
      if (loading) return;
      retryBtn.disabled = true;
      if (retryVoice) void startRecording();
      else void sendQuery(retryText);
    });

    bubble.append(textDiv, retryBtn);
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  }

  /**
   * Base del backend.
   *
   * En produccion la landing y el backend van detras del mismo reverse proxy,
   * asi que el mismo origen es correcto y no hay CORS. Vercel usa el mismo
   * patron mediante el rewrite de landing/vercel.json. En desarrollo la
   * landing corre en :4321 (Astro) y el backend en :8000: con el mismo origen
   * el fetch iba a localhost:4321/api/... y no respondia nada. Por eso la
   * demo "no funcionaba" en local.
   *
   * PUBLIC_API_URL permite apuntar a otro host si hace falta (por ejemplo,
   * landing en Cloudflare Pages y backend en el VPS).
   */
  function apiBase(): string {
    // Los dominios *.vercel.app usan el proxy same-origin de Vercel. Asi el
    // navegador no depende de que el VPS conozca cada URL de preview.
    if (window.location.hostname.endsWith(".vercel.app")) {
      return window.location.origin;
    }

    const configurada = import.meta.env.PUBLIC_API_URL;
    if (configurada) return String(configurada).replace(/\/$/, "");

    const esDesarrolloLocal =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1";
    if (esDesarrolloLocal && window.location.port !== "8000") {
      return `${window.location.protocol}//${window.location.hostname}:8000`;
    }
    return window.location.origin;
  }

  function setRecordingState(recording: boolean) {
    micBtn.classList.toggle("is-recording", recording);
    micBtn.setAttribute(
      "aria-label",
      recording ? "Detener grabación" : "Grabar consulta de voz",
    );
    micBtn.title = recording ? "Detener grabación" : "Grabar consulta de voz";
    setChatStatus(recording ? "grabando audio..." : "en línea");
  }

  function releaseRecorder() {
    if (recordingTimeout !== undefined) window.clearTimeout(recordingTimeout);
    recordingTimeout = undefined;
    recorderStream?.getTracks().forEach((track) => track.stop());
    recorderStream = null;
    recorder = null;
    recordingChunks = [];
    setRecordingState(false);
  }

  function encodeAudio(blob: Blob): Promise<string> {
    return blob.arrayBuffer().then((buffer) => {
      const bytes = new Uint8Array(buffer);
      let binary = "";
      const chunkSize = 0x8000;
      for (let offset = 0; offset < bytes.length; offset += chunkSize) {
        binary += String.fromCharCode(...bytes.subarray(offset, offset + chunkSize));
      }
      return btoa(binary);
    });
  }

  async function startRecording() {
    if (loading || recorder || starting) return;
    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") {
      showError("Este navegador no permite grabar audio. Puedes escribir la consulta.");
      return;
    }
    starting = true;

    try {
      recorderStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mimeType = ["audio/ogg;codecs=opus", "audio/webm;codecs=opus", "audio/webm"]
        .find((candidate) => MediaRecorder.isTypeSupported(candidate));
      recorder = mimeType ? new MediaRecorder(recorderStream, { mimeType }) : new MediaRecorder(recorderStream);
      recordingChunks = [];
      recorder.addEventListener("dataavailable", (event) => {
        if (event.data.size > 0) recordingChunks.push(event.data);
      });
      recorder.addEventListener("stop", () => {
        const blob = new Blob(recordingChunks, { type: recorder?.mimeType || "audio/ogg" });
        releaseRecorder();
        if (blob.size === 0) {
          showError("No se capturó audio. Inténtalo de nuevo o escribe la consulta.");
          return;
        }
        void encodeAudio(blob).then((audioBase64) => sendQuery("", audioBase64));
      }, { once: true });
      recorder.start();
      setRecordingState(true);
      recordingTimeout = window.setTimeout(stopRecording, 20000);
    } catch {
      releaseRecorder();
      showError("No pudimos acceder al micrófono. Revisa el permiso del navegador.");
    } finally {
      starting = false;
    }
  }

  function stopRecording() {
    if (recorder?.state === "recording") recorder.stop();
  }

  micBtn.addEventListener("click", () => {
    if (recorder?.state === "recording") stopRecording();
    else void startRecording();
  });

  async function sendQuery(text: string, audioBase64 = "") {
    if (loading || (!text.trim() && !audioBase64)) return;

    const isVoice = Boolean(audioBase64);
    const historial = isVoice ? [] : [...chatHistory];
    if (isVoice) {
      addVoiceBubble();
      // La transcripcion ocurre en el backend; el marcador mantiene el par
      // user/assistant balanceado para que la proxima consulta de texto no
      // envie un turno assistant huerfano como contexto.
      rememberTurn("user", "[audio]");
    } else {
      addBubble(text, "sent");
      rememberTurn("user", text);
    }
    setLoading(isVoice ? "Transcribiendo y consultando..." : "Consultando...");

    try {
      const apiUrl = apiBase() + "/api/v1/demo/preguntar";
      const resp = await fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ texto: text, audio_base64: audioBase64 || null, historial }),
      });

      if (!resp.ok) {
        let errorMessage: string;
        if (resp.status === 429) {
          errorMessage = "Demasiadas consultas. Espera un minuto y vuelve a intentarlo.";
        } else if (resp.status === 503) {
          errorMessage = "La demo no está disponible en este momento.";
        } else {
          const errData = await resp.json().catch(() => ({ detail: "Error inesperado" }));
          errorMessage = apiErrorMessage(errData.detail);
        }
        showError(errorMessage);
        addRetryBubble(errorMessage, text, isVoice);
        return;
      }

      const data: unknown = await resp.json();
      if (!data || typeof data !== "object" || !("texto" in data) || typeof data.texto !== "string") {
        throw new Error("Respuesta inválida del servidor");
      }
      const responseAudioBase64 = "audio_base64" in data && typeof data.audio_base64 === "string"
        ? data.audio_base64
        : undefined;
      removeTypingBubble();
      addBubble(data.texto, "received", undefined, responseAudioBase64);
      rememberTurn("assistant", data.texto);
      clearLoading();
    } catch {
      const errorMessage = "No se pudo conectar con AgroVoz. Revisa tu conexión e inténtalo de nuevo.";
      showError(errorMessage);
      addRetryBubble(errorMessage, text, isVoice);
    }
  }

  type LiveAction = "price" | "weather" | "sources";
  type PriceItem = { mercado: string; texto: string; fecha: string };
  type PricePayload = { total_mercados: number; precios: PriceItem[] };
  type WeatherPayload = { location: string; texto: string };
  type SourcePayload = { status: string; enabled: boolean };

  function liveResult(action: LiveAction): HTMLDivElement {
    return document.getElementById(`live-${action}-result`) as HTMLDivElement;
  }

  async function loadLiveData(action: LiveAction, button: HTMLButtonElement) {
    const result = liveResult(action);
    button.disabled = true;
    result.classList.remove("is-error");
    result.textContent = "Consultando…";

    const paths: Record<LiveAction, string> = {
      price: `/api/v1/prices/${encodeURIComponent(productSelect.value)}`,
      weather: "/api/v1/weather",
      sources: "/api/v1/data/sources",
    };

    try {
      const response = await fetch(apiBase() + paths[action]);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data: unknown = await response.json();

      if (action === "price") {
        const payload = data as PricePayload;
        const sample = payload.precios.slice(0, 2).map((item) => item.texto).join(" ");
        result.textContent = `${payload.total_mercados} mercados disponibles. ${sample}`;
      } else if (action === "weather") {
        const payload = data as WeatherPayload;
        result.textContent = payload.texto;
      } else {
        const sources = data as SourcePayload[];
        const stale = sources.filter((source) => source.status === "stale").length;
        const enabled = sources.filter((source) => source.enabled).length;
        result.textContent = `${sources.length} fuentes catalogadas; ${enabled} habilitadas y ${stale} con revisión pendiente.`;
      }
    } catch {
      result.classList.add("is-error");
      result.textContent = "No se pudo consultar este dato ahora.";
    } finally {
      button.disabled = false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-live-action]").forEach((button) => {
    button.addEventListener("click", () => {
      const action = button.dataset.liveAction as LiveAction;
      void loadLiveData(action, button);
    });
  });

  // Pobla el selector de la tarjeta de precios con el catalogo ODEPA real.
  // Si falla, el select queda con "papa" (default) y la tarjeta sigue
  // funcionando como antes.
  async function loadProducts() {
    try {
      const response = await fetch(apiBase() + "/api/v1/products");
      if (!response.ok) return;
      const products = (await response.json()) as string[];
      productSelect.replaceChildren(
        ...products.map((name) => {
          const option = document.createElement("option");
          option.value = name;
          option.textContent = name;
          return option;
        }),
      );
    } catch {
      /* sin catalogo: queda el default "papa" */
    }
  }
  void loadProducts();

  if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") {
    micBtn.hidden = true;
  }
  updateComposerState();

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    // Con una consulta en curso sendQuery retorna sin enviar: limpiar el input
    // antes de ese guard perdia el texto escrito (o el chip tocado) en silencio.
    if (loading) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = "";
    sendBtn.disabled = true;
    sendQuery(text);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-demo-prompt]").forEach((button) => {
    button.addEventListener("click", () => {
      if (loading) return;
      input.value = button.dataset.demoPrompt ?? "";
      sendBtn.disabled = input.value.trim().length === 0 || loading;
      form.dispatchEvent(new Event("submit"));
    });
  });

  messages.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === "LI" && target.textContent) {
      if (loading) return;
      input.value = target.textContent.trim();
      sendBtn.disabled = false;
      form.dispatchEvent(new Event("submit"));
    }
  });
</script>

