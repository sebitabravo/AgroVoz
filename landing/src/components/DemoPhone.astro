---
// Vista previa de telefono con conversacion de WhatsApp (#demo).
// Los mensajes aparecen en cascada via JS cuando entra en viewport.
//
// IMPORTANTE: esta vista es ilustrativa y no sustituye la demo interactiva.
// El precio de la papa y el estado del backend se resuelven contra la API
// real al cargar (script abajo); si el backend no responde, quedan los
// textos de respaldo sin fecha. /demo consulta el backend en cada interacción.
//
// Dos cosas que el sistema real SIEMPRE hace y el demo debe reflejar:
//   1. Cita la fuente ("segun ODEPA" / "segun OpenMeteo"). Es el diferencial
//      frente a un LLM que inventa: el dato es verificable.
//   2. Da la fecha del precio. ODEPA publica con rezago; ocultarlo seria
//      hacer pasar un precio de hace dias por el de hoy.
const messages = [
  {
    side: "sent",
    time: "0:05",
    text: "¿A cuánto está la papa?",
    i18n: "demo.m1",
  },
  {
    side: "received",
    time: "0:08",
    text: "Papa según ODEPA, con el precio más reciente disponible.",
    i18n: "demo.m2",
  },
  {
    side: "sent",
    time: "0:04",
    text: "¿Y va a llover en Traiguén mañana?",
    i18n: "demo.m3",
  },
  {
    side: "received",
    time: "0:07",
    text: "Mañana en Traiguén: máxima de 14 grados y mínima de 9, 23,9 milímetros de lluvia. Según OpenMeteo.",
    i18n: "demo.m4",
  },
];
---

<div class="demo-phone" id="demo-phone">
  <div class="demo-phone__notch" aria-hidden="true"></div>
  <div class="demo-phone__screen">
    <div class="demo-phone__header">
      <div class="demo-phone__avatar" aria-hidden="true">A</div>
      <div>
        <div class="demo-phone__name">AgroVoz</div>
        <div class="demo-phone__status">conectando…</div>
      </div>
    </div>
    <div class="demo-phone__chat">
      {
        messages.map((m) => (
          <div class={`bubble bubble--${m.side}`} data-msg>
            <span {...(m.i18n ? { "data-i18n": m.i18n } : {})}>{m.text}</span>
            <span class="bubble__time">{m.time}</span>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  /**
   * Base del backend — mismo patrón que la demo interactiva (demo.astro):
   * same-origin vía proxy Vercel en producción, localhost:8000 en desarrollo.
   */
  function apiBase(): string {
    // Los dominios *.vercel.app usan el proxy same-origin de Vercel.
    if (window.location.hostname.endsWith(".vercel.app")) {
      return window.location.origin;
    }

    const configurada = import.meta.env.PUBLIC_API_URL;
    if (configurada) return String(configurada).replace(/\/$/, "");

    const esDesarrolloLocal =
      window.location.hostname === "localhost" ||
      window.location.hostname === "127.0.0.1";
    if (esDesarrolloLocal && window.location.port !== "8000") {
      return `${window.location.protocol}//${window.location.hostname}:8000`;
    }
    return window.location.origin;
  }

  const statusEl = document.querySelector<HTMLElement>(".demo-phone__status");
  const langEs = () => document.documentElement.lang !== "en";
  const statusLabels = () =>
    langEs()
      ? { online: "en línea", offline: "sin conexión" }
      : { online: "online", offline: "offline" };

  // Ultimo resultado de /health; la label se re-resuelve al momento de pintar
  // para que el toggle de idioma (index.astro) la retraduzca sin re-consultar.
  let healthResult: "online" | "offline" | null = null;
  function applyStatusLabel() {
    if (healthResult && statusEl) statusEl.textContent = statusLabels()[healthResult];
  }

  // El "en línea" estático podía mentir: se resuelve contra /health al cargar.
  async function checkHealth() {
    try {
      const resp = await fetch(apiBase() + "/api/v1/health");
      healthResult = resp.ok ? "online" : "offline";
    } catch {
      healthResult = "offline";
    }
    applyStatusLabel();
  }
  void checkHealth();

  new MutationObserver(applyStatusLabel).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["lang"],
  });

  // El precio del mensaje sale con la fecha real del dato ODEPA, no con una
  // fecha fija del mockup. Si el backend no responde, queda el texto de
  // respaldo sin fecha.
  const priceEl = document.querySelector<HTMLElement>('[data-i18n="demo.m2"]');
  async function refreshPrice() {
    try {
      const resp = await fetch(apiBase() + "/api/v1/prices/papa");
      if (!resp.ok) return;
      const payload = (await resp.json()) as {
        precios: Array<{ mercado: string; texto: string }>;
      };
      // Prefiere Lo Valledor (el mercado del ejemplo) aunque la API incluya
      // el nombre institucional completo, y cae al primero si no existe.
      const precio =
        payload.precios.find((p) => p.mercado.toLowerCase().includes("lo valledor")) ??
        payload.precios[0];
      if (!precio || !priceEl) return;
      // dataset.es es la fuente de verdad ES del toggle de idioma (index.astro).
      priceEl.dataset.es = precio.texto;
      if (langEs()) priceEl.textContent = precio.texto;
    } catch {
      /* sin backend: queda el texto de respaldo */
    }
  }
  void refreshPrice();
</script>
