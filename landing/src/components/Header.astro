---
// Header sticky con backdrop-blur, navegacion ancla, toggle de idioma ES/EN.
// En mobile (<920px) la nav se vuelve un drawer abierto por el boton hamburguesa.
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a href="/#top" class="logo" aria-label="AgroVoz inicio">
      <span class="logo__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      AgroVoz
    </a>

    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="nav"
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav class="nav" id="nav" aria-label="Principal" aria-hidden="false">
      <a href="/#como" data-i18n="nav.como">Cómo funciona</a>
      <a href="/#demo" data-i18n="nav.demo">Demo</a>
      <a href="/#ecosistema" data-i18n="nav.ecosistema">Ecosistema</a>
      <a href="/#planes" data-i18n="nav.planes">Planes</a>
      <a href="/#stack" data-i18n="nav.stack">Tecnología</a>
      <a href="/#impacto" data-i18n="nav.impacto">Impacto</a>
    </nav>

    <div class="header-actions">
      <div class="lang-toggle" role="group" aria-label="Idioma">
        <button type="button" id="lang-es" data-lang="es">ES</button>
        <button type="button" id="lang-en" data-lang="en">EN</button>
      </div>
      <a href="/#contacto" class="pill" data-i18n="nav.contacto">Contacto</a>
    </div>
  </div>
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
</header>

<script>
  // Drawer de navegación compartido por la landing y las páginas públicas.
  const header = document.getElementById("site-header");
  const navToggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("nav");
  const navBackdrop = document.getElementById("nav-backdrop");

  function setNav(open: boolean) {
    if (!header || !navToggle) return;
    header.classList.toggle("nav-open", open);
    navToggle.setAttribute("aria-expanded", open ? "true" : "false");
    navToggle.setAttribute(
      "aria-label",
      open ? "Cerrar menú de navegación" : "Abrir menú de navegación",
    );
    const mobileClosed = !open && window.innerWidth <= 920;
    nav?.setAttribute("aria-hidden", mobileClosed ? "true" : "false");
    // aria-hidden no quita el foco de los enlaces descendientes. `inert`
    // evita que el teclado entre a un drawer cerrado en mobile.
    nav?.toggleAttribute("inert", mobileClosed);
    document.body.style.overflow = open && window.innerWidth <= 920 ? "hidden" : "";

    // Si Escape o el backdrop cierran el drawer desde un enlace, el foco no
    // debe quedar dentro de un elemento que acaba de quedar inert.
    if (mobileClosed && nav?.contains(document.activeElement)) {
      navToggle.focus();
    }
  }

  setNav(false);
  navToggle?.addEventListener("click", () =>
    setNav(!header?.classList.contains("nav-open")),
  );
  document.querySelectorAll<HTMLElement>("#nav a").forEach((a) =>
    a.addEventListener("click", () => setNav(false)),
  );
  navBackdrop?.addEventListener("click", () => setNav(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setNav(false);
  });
  window.matchMedia("(min-width: 921px)").addEventListener("change", (event) => {
    if (event.matches) setNav(false);
  });
</script>
