---
// Footer: marca, navegacion, credito institucional.
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="footer-logo">
      <a href="/#top" class="logo" aria-label="AgroVoz inicio">
        <span class="logo__bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        AgroVoz
      </a>
      <p class="footer-tagline" data-i18n="hero.title">
        Tu voz tiene el precio justo.
      </p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="/#como" data-i18n="nav.como">Cómo funciona</a>
      <a href="/#planes" data-i18n="nav.planes">Planes</a>
      <a href="/#impacto" data-i18n="nav.impacto">Impacto</a>
      <a href="/#contacto" data-i18n="nav.contacto">Contacto</a>
      <a
        href="/privacidad/"
        data-i18n="footer.privacy">Privacidad (Ley 21.719)</a
      >
      <a
        href="https://github.com/sebitabravo/AgroVoz/blob/main/docs/legal/aviso-responsabilidad.md"
        target="_blank"
        rel="noopener noreferrer"
        data-i18n="footer.notice">Aviso legal</a
      >
      <a
        href="https://github.com/sebitabravo/AgroVoz"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
    </nav>

    <div class="footer-bottom">
      <span>© 2026 AgroVoz</span>
      <span data-i18n="footer.credit"
        >Nacido en INACAP Temuco · Desafío Crea INACAP 2026</span
      >
    </div>
  </div>
</footer>
