---
// Formulario de contacto (#contacto). El submit se procesa en la Function
// server-side /api/contact; el destinatario vive solo en Vercel Environment
// Variables y nunca se entrega al navegador.
interface Props {
  formAction?: string;
}

const { formAction = "/api/contact" } = Astro.props;

const chips = [
  { plan: "institucional", label: "Institucional", i18n: "form.chip.inst" },
  { plan: "convenios", label: "Convenios", i18n: "form.chip.convenios" },
  { plan: "general", label: "Consulta general", i18n: "form.chip.general" },
];
---

<form
  class="contact-form"
  id="contact-form"
  action={formAction}
  method="post"
  data-contact-form
>
  <div class="chip-grid">
    {
      chips.map((c) => (
        <button
          type="button"
          class="chip"
          data-plan-chip={c.plan}
          aria-pressed="false"
          {...(c.i18n ? { "data-i18n": c.i18n } : {})}
        >
          {c.label}
        </button>
      ))
    }
  </div>

  <div class="field">
    <label for="cf-name" data-i18n="form.name">Nombre</label>
    <input
      id="cf-name"
      name="name"
      type="text"
      autocomplete="name"
      placeholder="Tu nombre"
      required
      data-i18n-ph="form.nameph"
    />
  </div>

  <div class="field">
    <label for="cf-email" data-i18n="form.email">Email</label>
    <input
      id="cf-email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder="tu@correo.cl"
      required
      data-i18n-ph="form.emailph"
    />
  </div>

  <div class="field">
    <label for="cf-msg" data-i18n="form.msg">Mensaje</label>
    <textarea
      id="cf-msg"
      name="message"
      rows="3"
      placeholder="¿Cómo podemos colaborar?"
      required
      data-i18n-ph="form.msgph"></textarea>
  </div>

  <div class="contact-form__trap" aria-hidden="true">
    <label for="cf-website">Sitio web</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div id="contact-status" class="contact-form__status" role="status" aria-live="polite" hidden></div>

  <button type="submit" class="btn btn-primary" style="width:100%" data-i18n="form.submit">
    Solicitar demo
  </button>
</form>
