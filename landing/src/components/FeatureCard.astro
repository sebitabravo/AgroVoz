---
// Card reutilizable: pasos numerados (#como) y fichas de tecnologia (#stack).
interface Props {
  step?: string;
  title: string;
  description?: string;
  subtitle?: string;
  variant?: "step" | "stack";
  revealDelay?: number;
  i18nTitle?: string;
  i18nDescription?: string;
  i18nSubtitle?: string;
  // SVG inline (string HTML) para fichas de tecnologia (#stack).
  icon?: string;
}

const {
  step,
  title,
  description,
  subtitle,
  variant = "step",
  revealDelay = 0,
  i18nTitle,
  i18nDescription,
  i18nSubtitle,
  icon,
} = Astro.props;

const revealAttr: Record<string, string> = { "data-reveal": "" };
if (revealDelay) revealAttr["data-reveal-delay"] = `${revealDelay}ms`;
---

<div
  class={variant === "stack" ? "stack-card" : "card"}
  {...revealAttr}
>
  {
    step && (
      <div class="step-num" aria-hidden="true">
        {step}
      </div>
    )
  }
  {
    icon && (
      <span class="stack-icon" set:html={icon} aria-hidden="true" />
    )
  }
  <h3 class="card-title" {...(i18nTitle ? { "data-i18n": i18nTitle } : {})}>
    {title}
  </h3>
  {
    subtitle && (
      <p class="card-sub" {...(i18nSubtitle ? { "data-i18n": i18nSubtitle } : {})}>
        {subtitle}
      </p>
    )
  }
  {
    description && (
      <p
        style="margin-top:12px;font-size:15px;color:var(--color-muted);line-height:1.55"
        {...(i18nDescription ? { "data-i18n": i18nDescription } : {})}
      >
        {description}
      </p>
    )
  }
</div>
