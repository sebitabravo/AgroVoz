# AgroVoz — Variables de entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitees .env al repo.

# ── Servidor ──────────────────────────
APP_ENV=development
APP_VERSION=0.1.0-dev
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── Base de datos ─────────────────────
DATABASE_URL=sqlite:///data/agrovoz.db

# ── Open-WA (gateway WhatsApp self-hosted) ──
# API key admin para autenticarse contra Open-WA (dashboard + API REST).
#
# En desarrollo la key está hardcodeada en docker-compose.yml: "dev-admin-key".
# No necesitás setear OPENWA_API_KEY a menos que quieras una key custom.
# Si la cambiás, editá docker-compose.yml y poné:
#   API_MASTER_KEY=${OPENWA_API_KEY:-dev-admin-key}
#
# IMPORTANTE: API_MASTER_KEY solo se usa en el PRIMER arranque (DB vacía).
# Si la DB ya tiene keys, se ignora en reinicios. Para resetear:
#   docker compose down && docker volume rm agrovoz_openwa_data
#
# Webhook Secret: validación HMAC de webhooks entrantes.
#   En desarrollo el default es "dev-webhook-secret" (docker-compose.yml).
#   En producción, generá un UUID v4: uuidgen | tr '[:upper:]' '[:lower:]'
# API URL: http://localhost:2785 desde el host (desarrollo sin Docker).
# Docker Compose sobreescribe a http://openwa:8000 automáticamente (red interna).
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=dev-webhook-secret
OPENWA_API_URL=http://localhost:2785

# ── OpenWeatherMap ───────────────────
OPENWEATHERMAP_API_KEY=

# ── ODEPA ────────────────────────────
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ───────────────────────
WHISPER_MODEL=small
# Directorio para modelos Whisper. Vacio = default ~/.cache/whisper/.
# En Docker, montar volumen en /app/models/whisper/.
WHISPER_MODEL_PATH=
LLM_MODEL_PATH=models/qwen2.5-3b-q4_k_m.gguf
PIPER_VOICE=es_ES-carlfm-x_low
# Ruta al archivo .voice del modelo Piper. Descargar desde:
# https://huggingface.co/rhasspy/piper-voices/tree/main/es/es_ES/carlfm/x_low
# En Docker: /app/models/es_ES-carlfm-x_low.voice
PIPER_MODEL_PATH=models/es_ES-carlfm-x_low.onnx

# ── Admin ────────────────────────────
ADMIN_API_KEY=

# ── Seguridad ────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUDIO_RETENTION_HOURS=24
PHONE_HASH_PEPPER=agrovoz-dev-pepper  # Cambiar por valor secreto en producción
# IPs/hosts extra separadas por coma para TrustedHostMiddleware.
# En desarrollo Docker, la IP de la red de Docker para webhooks de OpenWA.
EXTRA_ALLOWED_HOSTS=192.168.97.2

# ── Logging ───────────────────────────
LOG_LEVEL=DEBUG
