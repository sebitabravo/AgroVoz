# AgroVoz — Variables de entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitees .env al repo.

# ── Servidor ──────────────────────────
APP_ENV=development
APP_VERSION=0.1.0-dev
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── Base de datos ─────────────────────
DATABASE_URL=sqlite:///data/agrovoz.db

# ── Open-WA (gateway WhatsApp self-hosted) ──
# API Key: generá un UUID v4 para autenticación del backend hacia Open-WA.
#   uuidgen | tr '[:upper:]' '[:lower:]'
# Webhook Secret: generá otro UUID v4 para validación HMAC de webhooks entrantes.
#   uuidgen | tr '[:upper:]' '[:lower:]'
# API URL: http://openwa:8000 (interno Docker) o http://localhost:2785 (desde host).
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_API_URL=http://openwa:8000

# ── OpenWeatherMap ───────────────────
OPENWEATHERMAP_API_KEY=

# ── ODEPA ────────────────────────────
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ───────────────────────
WHISPER_MODEL=small
LLM_MODEL_PATH=models/qwen2.5-3b-q4_k_m.gguf
PIPER_VOICE=es_ES-carlfm-x_low

# ── Admin ────────────────────────────
ADMIN_API_KEY=

# ── Seguridad ────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUDIO_RETENTION_HOURS=24
PHONE_HASH_PEPPER=agrovoz-dev-pepper  # Cambiar por valor secreto en producción

# ── Logging ───────────────────────────
LOG_LEVEL=DEBUG
