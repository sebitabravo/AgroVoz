# AgroVoz — Variables de entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitees .env al repo.

# ── Servidor ──────────────────────────
APP_ENV=development
DEBUG=true

# ── Twilio WhatsApp ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14155238886

# ── OpenWeatherMap ───────────────────
OPENWEATHER_API_KEY=

# ── ODEPA ────────────────────────────
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ───────────────────────
WHISPER_MODEL=small
LLM_MODEL_PATH=models/qwen2.5-3b-q4_k_m.gguf
PIPER_VOICE=es_ES-carlfm-x_low

# ── Admin ────────────────────────────
ADMIN_API_KEY=

# ── Seguridad ────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUDIO_RETENTION_HOURS=24
