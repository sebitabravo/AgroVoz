# AgroVoz — Variables de entorno
# Copiar a .env: cp .env.example .env
# NUNCA commitees .env al repo.

# ── Servidor ──────────────────────────
APP_ENV=development
APP_VERSION=0.1.0-dev
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── Base de datos ─────────────────────
DATABASE_URL=sqlite:///data/agrovoz.db

# ── Open-WA (gateway WhatsApp self-hosted) ──
# API_MASTER_KEY: seed de API key inicial (solo primer arranque, DB vacía).
#   Si se setea → usa ese valor como API key admin.
#   Si no y ALLOW_DEV_API_KEY=true → usa "dev-admin-key" (SOLO desarrollo).
#   Si no → auto-genera owa_k1_<random> (la muestra en logs de arranque).
#   Generá un UUID v4:
#     uuidgen | tr '[:upper:]' '[:lower:]'
# Webhook Secret: validación HMAC de webhooks entrantes (issue #11).
#   Generá otro UUID v4 distinto.
# API URL: http://openwa:8000 (interno Docker) o http://localhost:2785 (desde host).
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_API_URL=http://openwa:8000

# ── OpenWeatherMap ───────────────────
OPENWEATHERMAP_API_KEY=

# ── ODEPA ────────────────────────────
ODEPA_SYNC_HOUR=6
ODEPA_SYNC_MINUTE=0

# ── Modelos IA ───────────────────────
WHISPER_MODEL=small
LLM_MODEL_PATH=models/qwen2.5-3b-q4_k_m.gguf
PIPER_VOICE=es_ES-carlfm-x_low

# ── Admin ────────────────────────────
ADMIN_API_KEY=

# ── Seguridad ────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUDIO_RETENTION_HOURS=24
PHONE_HASH_PEPPER=agrovoz-dev-pepper  # Cambiar por valor secreto en producción

# ── Logging ───────────────────────────
LOG_LEVEL=DEBUG
